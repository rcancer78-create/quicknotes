<Window x:Class="QuickNotes.App.Views.CloudSetupWizardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Подключение Yandex Object Storage"
        Width="620" Height="560"
        MinWidth="520" MinHeight="440"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource CanvasBrush}">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Мастер подключения второго устройства" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}"/>
            <TextBlock x:Name="StepTitle" FontSize="13" Foreground="{DynamicResource MutedBrush}" Margin="0,6,0,0" TextWrapping="Wrap"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" Margin="0,16,0,12" VerticalScrollBarVisibility="Auto">
            <Grid>
                <StackPanel x:Name="Step0Panel">
                    <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource InkBrush}"
                               Text="Облако изначально выключено. Этот мастер помогает подключить закрытый бакет Yandex Object Storage, чтобы обмениваться заметками между компьютерами. На каждом устройстве нужен один и тот же бакет, префикс и мастер-пароль шифрования."/>
                    <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource InkBrush}" Margin="0,12,0,0"
                               Text="Подготовьте: имя бакета, статический ключ сервисного аккаунта с правами только на этот бакет и мастер-пароль, который вы никому не передаёте."/>
                </StackPanel>

                <StackPanel x:Name="Step1Panel" Visibility="Collapsed">
                    <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource InkBrush}"
                               Text="В консоли Yandex Cloud создайте закрытый бакет Object Storage и сервисный аккаунт. Выдайте ему минимальные права на этот бакет (чтение и запись объектов) и создайте статический ключ доступа."/>
                    <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0,10,0,0"
                               Text="Приложение не создаёт бакет и ключи за вас. Если шаг ещё не выполнен в консоли, вернитесь сюда позже — локальные заметки продолжат работать."/>
                </StackPanel>

                <StackPanel x:Name="Step2Panel" Visibility="Collapsed">
                    <TextBlock Text="Имя бакета" FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}" Margin="0,0,0,6"/>
                    <TextBox Text="{Binding SyncBucket, UpdateSourceTrigger=PropertyChanged}" Height="32" VerticalContentAlignment="Center" Padding="8,0"
                             ToolTip="DNS-имя бакета: строчные буквы, цифры и дефисы"/>
                    <TextBlock Text="Префикс (необязательно)" FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}" Margin="0,12,0,6"/>
                    <TextBox Text="{Binding SyncPrefix, UpdateSourceTrigger=PropertyChanged}" Height="32" VerticalContentAlignment="Center" Padding="8,0"
                             ToolTip="Папка внутри бакета, например quicknotes"/>
                    <TextBlock x:Name="Step2Error" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource ErrorBannerFgBrush}" Margin="0,8,0,0"/>
                </StackPanel>

                <StackPanel x:Name="Step3Panel" Visibility="Collapsed">
                    <TextBlock Text="Идентификатор ключа" FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}" Margin="0,0,0,6"/>
                    <TextBox Text="{Binding SyncAccessKeyId, UpdateSourceTrigger=PropertyChanged}" Height="32" VerticalContentAlignment="Center" Padding="8,0"/>
                    <TextBlock Text="Секретный ключ" FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}" Margin="0,12,0,6"/>
                    <PasswordBox x:Name="WizardSecretBox" Height="32" VerticalContentAlignment="Center" Padding="8,0"/>
                    <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0,8,0,0"
                               Text="Ключи сохраняются только в защищённом хранилище Windows и не попадают в базу заметок."/>
                    <TextBlock x:Name="Step3Error" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource ErrorBannerFgBrush}" Margin="0,8,0,0"/>
                </StackPanel>

                <StackPanel x:Name="Step4Panel" Visibility="Collapsed">
                    <TextBlock Text="Мастер-пароль шифрования" FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}" Margin="0,0,0,6"/>
                    <PasswordBox x:Name="WizardPasswordBox" Height="32" VerticalContentAlignment="Center" Padding="8,0"/>
                    <TextBlock Text="Подтверждение пароля" FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}" Margin="0,12,0,6"/>
                    <PasswordBox x:Name="WizardPasswordConfirmBox" Height="32" VerticalContentAlignment="Center" Padding="8,0"/>
                    <Border Background="{DynamicResource WarningBannerBgBrush}" BorderBrush="{DynamicResource WarningBannerBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,12,0,0">
                        <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource WarningBannerFgBrush}"
                                   Text="На втором устройстве укажите тот же пароль. Если пароль потерян, облачные копии расшифровать нельзя."/>
                    </Border>
                    <TextBlock x:Name="Step4Error" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource ErrorBannerFgBrush}" Margin="0,8,0,0"/>
                </StackPanel>

                <StackPanel x:Name="Step5Panel" Visibility="Collapsed">
                    <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource InkBrush}"
                               Text="Проверьте доступ к бакету. Если проверка не прошла, вернитесь на нужный шаг и исправьте имя бакета, ключи или сеть — локальные заметки при этом не затрагиваются."/>
                    <TextBlock Text="{Binding SyncConnectionStatusText}" TextWrapping="Wrap" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource InkBrush}" Margin="0,12,0,0"/>
                    <Button Content="Проверить подключение" Command="{Binding TestConnectionCommand}"
                            Height="34" Padding="14,0" Margin="0,12,0,0" HorizontalAlignment="Left"
                            Background="{DynamicResource ButtonBgBrush}" Foreground="{DynamicResource ButtonFgBrush}"/>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <TextBlock Grid.Row="2" x:Name="StepHint" FontSize="12" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,10"/>

        <DockPanel Grid.Row="3" LastChildFill="False">
            <Button Content="Отмена" Click="Cancel_Click" Height="34" Width="100" DockPanel.Dock="Left"
                    Background="{DynamicResource ButtonBgBrush}" Foreground="{DynamicResource ButtonFgBrush}"/>
            <Button x:Name="NextButton" Content="Далее" Click="Next_Click" Height="34" Width="120" DockPanel.Dock="Right"
                    Background="{DynamicResource AccentBrush}" Foreground="White" FontWeight="SemiBold"/>
            <Button x:Name="BackButton" Content="Назад" Click="Back_Click" Height="34" Width="100" Margin="0,0,8,0" DockPanel.Dock="Right"
                    Background="{DynamicResource ButtonBgBrush}" Foreground="{DynamicResource ButtonFgBrush}"/>
        </DockPanel>
    </Grid>
</Window>
