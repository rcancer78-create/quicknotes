<Window x:Class="QuickNotes.App.Views.TagSuggestionsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title}"
        Height="540" Width="580"
        MinHeight="400" MinWidth="480"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource CanvasBrush}">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- 0. Info / Explanation Banner -->
            <RowDefinition Height="*"/>    <!-- 1. Suggestions List / Empty Message -->
            <RowDefinition Height="Auto"/> <!-- 2. Selection Summary -->
            <RowDefinition Height="Auto"/> <!-- 3. Status & Action Buttons -->
        </Grid.RowDefinitions>

        <!-- 0. INFO / EXPLANATION BANNER -->
        <Border Grid.Row="0" Background="{DynamicResource InfoBannerBgBrush}" BorderBrush="{DynamicResource InfoBannerBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="💡" FontSize="16" Margin="0,0,10,0" VerticalAlignment="Top"/>
                <TextBlock Grid.Column="1" Text="{Binding InfoBannerText}" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource InfoBannerFgBrush}" FontWeight="Medium" LineHeight="17"/>
            </Grid>
        </Border>

        <!-- 1. SUGGESTIONS LIST -->
        <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="6" Padding="6" Margin="0,0,0,10">
            <Grid>
                <!-- When suggestions exist: Show ListBox -->
                <ListBox ItemsSource="{Binding Suggestions}"
                         SelectedItem="{Binding SelectedSuggestion}"
                         Visibility="{Binding HasSuggestionsVisibility}"
                         BorderThickness="0" Background="Transparent"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0,0,0,6"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="ItemBorder" Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="6" Padding="10,8" Cursor="Hand">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource SurfaceBrush}"/>
                                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource CardSelectedBgBrush}"/>
                                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                <Setter TargetName="ItemBorder" Property="BorderThickness" Value="1.5"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Row 0: Word and Count badge -->
                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="🏷️ " FontSize="12" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding Word}" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource InkBrush}" VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <Border Grid.Column="1" Background="{DynamicResource BadgeBgBrush}" CornerRadius="10" Padding="8,2" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding NotesCount, StringFormat='{}заметок: {0}'}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource BadgeFgBrush}"/>
                                    </Border>
                                </Grid>

                                <!-- Row 1: Preview snippet -->
                                <TextBlock Grid.Row="1" Text="{Binding Preview, StringFormat='{}«{0}»'}" FontSize="11" Foreground="{DynamicResource MutedBrush}"
                                           TextTrimming="CharacterEllipsis" Margin="0,4,0,0"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- When NO suggestions exist: Friendly empty state -->
                <Border Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="6" Padding="24"
                        Visibility="{Binding NoSuggestionsVisibility}" HorizontalAlignment="Stretch" VerticalAlignment="Center" Margin="10">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="✓ Новых предложений нет" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource SuccessBannerFgBrush}" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                        <TextBlock Text="Все часто повторяющиеся слова уже оформлены тегами или синонимами, либо встречаются менее чем в 2 заметках."
                                   FontSize="12" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="380"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- 2. SELECTION SUMMARY -->
        <Border Grid.Row="2" Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="6" Padding="10,7" Margin="0,0,0,10">
            <TextBlock Text="{Binding SelectedSuggestionSummary}" FontSize="12" Foreground="{DynamicResource InkBrush}" TextWrapping="Wrap"/>
        </Border>

        <!-- 3. STATUS & ACTION BUTTONS -->
        <Grid Grid.Row="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Status message -->
            <TextBlock Grid.Row="0" Text="{Binding StatusText}" FontSize="11" Foreground="{DynamicResource MutedBrush}"
                       TextWrapping="Wrap" Margin="0,0,0,8"/>

            <!-- Buttons -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Отмена" Command="{Binding CancelCommand}" IsCancel="True"
                        Width="90" Height="32" Margin="0,0,8,0"
                        ToolTip="Отмена"
                        Background="{DynamicResource ButtonBgBrush}" Foreground="{DynamicResource ButtonFgBrush}" BorderThickness="0" Cursor="Hand"/>
                <Button Content="Создать тег" Command="{Binding CreateTagCommand}" IsEnabled="{Binding CanCreateTag}" IsDefault="True"
                        Width="120" Height="32"
                        ToolTip="Создать тег из выбранного слова"
                        Background="{DynamicResource AccentBrush}" Foreground="White" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
