<Window x:Class="QuickNotes.App.Views.ScreenCropOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Захват области экрана"
        WindowStyle="None"
        AllowsTransparency="True"
        ShowInTaskbar="False"
        Topmost="True"
        Background="Transparent"
        Cursor="Cross"
        WindowStartupLocation="Manual"
        ShowActivated="True"
        Focusable="True"
        Loaded="Window_Loaded"
        PreviewKeyDown="Window_PreviewKeyDown"
        KeyDown="Window_KeyDown"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        MouseMove="Window_MouseMove"
        MouseLeftButtonUp="Window_MouseLeftButtonUp"
        MouseRightButtonDown="Window_MouseRightButtonDown"
        Closing="Window_Closing"
        Closed="Window_Closed">

    <Grid x:Name="OverlayRoot" Background="#4D000000">
        <!-- Canvas for Selection and Dimension Badge -->
        <Canvas x:Name="OverlayCanvas" ClipToBounds="True">
            <Border x:Name="SelectionBorder"
                    BorderBrush="#38BDF8"
                    BorderThickness="2"
                    Background="#2038BDF8"
                    Visibility="Collapsed"
                    IsHitTestVisible="False">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="4" ShadowDepth="0" Color="#0284C7" Opacity="0.6"/>
                </Border.Effect>
            </Border>

            <Border x:Name="SizeBadge"
                    Background="#CC0F172A"
                    BorderBrush="#475569"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="6,2"
                    Visibility="Collapsed"
                    IsHitTestVisible="False">
                <TextBlock x:Name="SizeText" Foreground="#F1F5F9" FontSize="11" FontWeight="Medium"/>
            </Border>
        </Canvas>

        <!-- Top instruction banner -->
        <Border HorizontalAlignment="Center" VerticalAlignment="Top"
                Margin="0,30,0,0"
                Background="#E60F172A"
                BorderBrush="#334155"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16,8"
                IsHitTestVisible="False">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="📷 Захват экрана: " FontWeight="SemiBold" Foreground="#F8FAFC" FontSize="13"/>
                <TextBlock Text="потяните курсор для выбора области | Esc — отмена" Foreground="#94A3B8" FontSize="13"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>