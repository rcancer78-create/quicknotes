<Window x:Class="QuickNotes.App.Views.TemplateManagementDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Шаблоны заметок"
        Width="700" Height="520"
        MinWidth="540" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource CanvasBrush}">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="Шаблоны заметок" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource InkBrush}"/>
                <TextBlock Text="Создавайте и настраивайте шаблоны с готовым текстом, переменными и тегами."
                           FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0,2,0,0"/>
            </StackPanel>
            <Button Grid.Column="1" Content="+ Создать шаблон" Command="{Binding CreateCommand}"
                    Height="32" Padding="14,0"
                    Background="{DynamicResource AccentBrush}" Foreground="White" FontWeight="SemiBold"
                    ToolTip="Создать новый шаблон заметки" VerticalAlignment="Center"/>
        </Grid>

        <!-- Templates List / Empty State -->
        <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="8" Padding="2" Margin="0,0,0,14">
            <Grid>
                <!-- Empty state -->
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="20">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsEmpty}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Text="📄" FontSize="36" HorizontalAlignment="Center" Margin="0,0,0,8" Opacity="0.6"/>
                    <TextBlock Text="Нет созданных шаблонов" FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource InkBrush}" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                    <TextBlock Text="Нажмите кнопку «+ Создать шаблон», чтобы добавить первый шаблон." FontSize="12" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- ListBox -->
                <ListBox x:Name="TemplatesListBox" ItemsSource="{Binding Templates}" SelectedItem="{Binding SelectedTemplate}"
                         BorderThickness="0" Background="Transparent"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         MouseDoubleClick="TemplatesListBox_MouseDoubleClick"
                         KeyDown="TemplatesListBox_KeyDown">
                    <ListBox.Style>
                        <Style TargetType="ListBox">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsEmpty}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ListBox.Style>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="10,8" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Background="Transparent">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Title -->
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding Title}" FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource InkBrush}" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding FormattedDate}" FontSize="11" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>

                                    <!-- Snippet -->
                                    <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Text="{Binding Snippet}" FontSize="12" Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis" Margin="0,4,0,6"/>

                                    <!-- Tags -->
                                    <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="Теги: " FontSize="11" FontWeight="Medium" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding TagsSummary}" FontSize="11" Foreground="{DynamicResource InkBrush}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <!-- Bottom Action Bar -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Edit and Delete -->
            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <Button Content="Изменить" Command="{Binding EditCommand}"
                        Height="32" Padding="14,0" Margin="0,0,8,0"
                        Background="{DynamicResource ButtonBgBrush}" Foreground="{DynamicResource ButtonFgBrush}" FontWeight="Medium"
                        ToolTip="Редактировать выбранный шаблон"/>
                <Button Content="Удалить" Command="{Binding DeleteCommand}"
                        Height="32" Padding="14,0"
                        Background="{DynamicResource ButtonBgBrush}" Foreground="{DynamicResource ErrorBannerFgBrush}" FontWeight="Medium"
                        ToolTip="Удалить выбранный шаблон"/>
            </StackPanel>

            <!-- Close -->
            <Button Grid.Column="2" Content="Закрыть" Command="{Binding CloseCommand}"
                    IsCancel="True" Height="32" Padding="16,0"
                    Background="{DynamicResource ButtonBgBrush}" Foreground="{DynamicResource ButtonFgBrush}" FontWeight="Medium"
                    ToolTip="Закрыть окно управления шаблонами"/>
        </Grid>
    </Grid>
</Window>
