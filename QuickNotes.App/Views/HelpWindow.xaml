<Window x:Class="QuickNotes.App.Views.HelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:h="clr-namespace:QuickNotes.App.Helpers"
        Title="Справка QuickNotes"
        Width="640" Height="560"
        MinWidth="480" MinHeight="400"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource CanvasBrush}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Краткая справка" FontSize="18" FontWeight="SemiBold"
                   Foreground="{DynamicResource InkBrush}" Margin="0,0,0,12"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Горячие клавиши" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}" Margin="0,0,0,6"/>
                <TextBlock x:Name="ShortcutsHelpText" TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource InkBrush}" Margin="0,0,0,14"/>

                <TextBlock Text="Карточки списка" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}" Margin="0,0,0,6"/>
                <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource InkBrush}" Margin="0,0,0,14"
                           Text="{x:Static h:CardGestureCopy.ListHelp}"/>

                <TextBlock Text="Закрытие окна и системный трей" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}" Margin="0,0,0,6"/>
                <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource InkBrush}" Margin="0,0,0,14"
                           Text="Крестик главного окна по умолчанию скрывает программу в системный трей: захват текста и мгновенное сохранение продолжают работать. Полный выход — через значок в трее, пункт «Выйти» или выбор «Выйти» в диалоге первого закрытия. Поведение крестика можно изменить в настройках."/>

                <TextBlock Text="Где хранятся данные" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}" Margin="0,0,0,6"/>
                <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource InkBrush}" Margin="0,0,0,14"
                           Text="Заметки, вложения и настройки хранятся только на этом компьютере в папке приложения Windows (локальные данные пользователя). Облако по умолчанию выключено и ничего не отправляет, пока вы сами его не подключите."/>

                <TextBlock Text="Резервное копирование и восстановление" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}" Margin="0,0,0,6"/>
                <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource InkBrush}" Margin="0,0,0,14"
                           Text="В настройках можно создать согласованную копию базы. Хранятся последние семь копий. При повреждении файла база предлагается восстановить из копии. Удаление программы не стирает папку с вашими заметками."/>

                <TextBlock Text="Экспорт" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}" Margin="0,0,0,6"/>
                <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource InkBrush}" Margin="0,0,0,14"
                           Text="Markdown, JSON и CSV — текстовые форматы без файлов-вложений. Полный перенос с картинками и документами выполняется архивом с паролем (команда в окне «Перенос заметок»). Существующие заметки при импорте не перезаписываются молча."/>

                <TextBlock Text="Облако и мастер-пароль" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}" Margin="0,0,0,6"/>
                <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource InkBrush}" Margin="0,0,0,8"
                           Text="Синхронизация идёт через ваш закрытый бакет Yandex Object Storage. Данные шифруются на компьютере (AES-256-GCM). Ключи доступа хранятся в защищённом хранилище Windows."/>
                <Border Background="{DynamicResource WarningBannerBgBrush}" BorderBrush="{DynamicResource WarningBannerBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,8">
                    <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource WarningBannerFgBrush}"
                               Text="Если мастер-пароль утерян, расшифровать облачные копии невозможно. Пароль нельзя восстановить из приложения. Сохраните его в надёжном месте до включения синхронизации."/>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Button Grid.Row="2" Content="Закрыть" IsCancel="True" IsDefault="True"
                Width="120" Height="34" HorizontalAlignment="Right" Margin="0,16,0,0"
                Background="{DynamicResource AccentBrush}" Foreground="White" FontWeight="SemiBold"/>
    </Grid>
</Window>
