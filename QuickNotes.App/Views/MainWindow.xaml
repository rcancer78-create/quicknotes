<Window x:Class="QuickNotes.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        xmlns:vm="clr-namespace:QuickNotes.App.ViewModels"
        xmlns:h="clr-namespace:QuickNotes.App.Helpers"
        Title="QuickNotes — Быстрые заметки"
        Height="700" Width="1050"
        MinHeight="500" MinWidth="640"
        WindowStartupLocation="CenterScreen"
        PreviewKeyDown="MainWindow_PreviewKeyDown"
        Background="{DynamicResource CanvasBrush}">

    <Window.InputBindings>
        <KeyBinding Key="F5" Command="{Binding SyncNowCommand}"/>
    </Window.InputBindings>

    <Window.Resources>
        <DataTemplate x:Key="TaskItemTemplate" DataType="{x:Type vm:TaskCardViewModel}">
            <Border Margin="0,0,0,8" Padding="12,10" CornerRadius="8"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource AccentBrush}"
                    BorderThickness="3,0,0,0"
                    Cursor="Hand">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="{Binding TaskText}" FontSize="13" FontWeight="SemiBold"
                               Foreground="{DynamicResource InkBrush}" TextWrapping="Wrap"/>
                    <TextBlock Grid.Row="1" FontSize="12" FontWeight="Medium" Foreground="{DynamicResource AccentBrush}" Margin="0,4,0,0"
                               Text="{Binding DueDateText, StringFormat='Срок {0}'}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasDueDate}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Grid.Row="2" Text="{Binding NoteTitle, StringFormat='Заметка: {0}'}" FontSize="11"
                               Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="NoteCardItemTemplate" DataType="{x:Type vm:NoteCardViewModel}">
            <Border x:Name="CardBorder" Background="{DynamicResource SurfaceBrush}"
                    CornerRadius="10" Margin="0,0,0,10"
                    Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}" Padding="0"
                    AutomationProperties.Name="{Binding DisplayTitle}"
                    MouseLeftButtonDown="CardSurface_MouseLeftButtonDown">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
                        <Setter Property="BorderThickness" Value="1"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}" Value="True">
                                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Setter Property="BorderThickness" Value="2"/>
                                <Setter Property="Background" Value="{DynamicResource CardSelectedBgBrush}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Border.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Редактировать"
                              Command="{Binding PlacementTarget.Tag.EditNoteCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                              CommandParameter="{Binding}"/>
                    <MenuItem Header="{Binding PlacementTarget.DataContext.FavoriteTooltip, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                              Command="{Binding PlacementTarget.DataContext.ToggleFavoriteCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                        <MenuItem.Style>
                            <Style TargetType="MenuItem">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding PlacementTarget.DataContext.IsDeleted, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </MenuItem.Style>
                    </MenuItem>
                    <MenuItem Header="{Binding PlacementTarget.DataContext.PinTooltip, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                              Command="{Binding PlacementTarget.DataContext.TogglePinCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                        <MenuItem.Style>
                            <Style TargetType="MenuItem">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding PlacementTarget.DataContext.IsDeleted, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </MenuItem.Style>
                    </MenuItem>
                    <MenuItem Header="Отметить обработанным"
                              Command="{Binding PlacementTarget.DataContext.MarkProcessedCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                        <MenuItem.Style>
                            <Style TargetType="MenuItem">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding PlacementTarget.DataContext.IsInbox, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Value="True"/>
                                            <Condition Binding="{Binding PlacementTarget.DataContext.IsDeleted, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Value="False"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </MenuItem.Style>
                    </MenuItem>
                    <MenuItem Header="Пересканировать теги"
                              Command="{Binding PlacementTarget.Tag.RescanNoteCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                              CommandParameter="{Binding}">
                        <MenuItem.Style>
                            <Style TargetType="MenuItem">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding PlacementTarget.DataContext.IsDeleted, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </MenuItem.Style>
                    </MenuItem>
                    <Separator>
                        <Separator.Style>
                            <Style TargetType="Separator">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding PlacementTarget.DataContext.IsDeleted, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Separator.Style>
                    </Separator>
                    <MenuItem Header="Переместить в корзину"
                              Command="{Binding PlacementTarget.DataContext.MoveToTrashCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                        <MenuItem.Style>
                            <Style TargetType="MenuItem">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding PlacementTarget.DataContext.IsDeleted, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </MenuItem.Style>
                    </MenuItem>

                    <!-- Trash specific menu items -->
                    <MenuItem Header="Восстановить"
                              Command="{Binding PlacementTarget.DataContext.RestoreCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                        <MenuItem.Style>
                            <Style TargetType="MenuItem">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding PlacementTarget.DataContext.IsDeleted, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </MenuItem.Style>
                    </MenuItem>
                    <MenuItem Header="Удалить навсегда"
                              Command="{Binding PlacementTarget.DataContext.PermanentDeleteCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                        <MenuItem.Style>
                            <Style TargetType="MenuItem">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding PlacementTarget.DataContext.IsDeleted, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </MenuItem.Style>
                    </MenuItem>
                </ContextMenu>
            </Border.ContextMenu>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Header -->
                    <RowDefinition Height="Auto"/> <!-- Source info -->
                    <RowDefinition Height="Auto"/> <!-- Body / Text -->
                    <RowDefinition Height="Auto"/> <!-- Footer / Tags -->
                </Grid.RowDefinitions>

                <!-- Card header: single click selects. Expand is an explicit button (UX-C14). -->
                <Border Grid.Row="0" Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1"
                        CornerRadius="12,12,0,0" Padding="14,8" Cursor="Hand"
                        ToolTip="{x:Static h:CardGestureCopy.HeaderTooltip}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="80"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource InkBrush}"
                                   TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                                   HorizontalAlignment="Stretch" VerticalAlignment="Center"
                                   Margin="0,0,8,0" ToolTip="{Binding DisplayTitle}"
                                   h:HighlightText.Source="{Binding DisplayTitle}"
                                   h:HighlightText.Query="{Binding HighlightQuery}"/>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding UpdatedAtShortText}" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,0,8,0" VerticalAlignment="Center"
                                       ToolTip="{Binding HeaderMetaTooltip}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsDeleted}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <Border Background="{DynamicResource ErrorBannerBgBrush}" CornerRadius="4" Padding="6,1" Margin="0,0,8,0" VerticalAlignment="Center">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsDeleted}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding DeletedAtShortText}" FontSize="11" Foreground="{DynamicResource ErrorBannerFgBrush}" FontWeight="Medium"
                                           ToolTip="{Binding DeletedAtText}"/>
                            </Border>

                            <!-- If Inbox: badge -->
                            <Border Background="{DynamicResource InfoBannerBgBrush}" CornerRadius="4" Padding="6,1" Margin="0,0,8,0" VerticalAlignment="Center">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding IsInbox}" Value="True"/>
                                                    <Condition Binding="{Binding IsDeleted}" Value="False"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="Входящие" FontSize="11" Foreground="{DynamicResource InfoBannerFgBrush}" FontWeight="Medium"/>
                            </Border>

                            <TextBlock Text="{Binding PublicationStatusText}" FontSize="11" Margin="0,0,4,0" VerticalAlignment="Center"
                                       Foreground="{DynamicResource MutedBrush}" FontWeight="Medium"
                                       ToolTip="{Binding PublicationStatusTooltip}"
                                       AutomationProperties.Name="{Binding PublicationStatusText}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ShowPublicationStatusOnCard}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>

                        <!-- Quick actions on card header -->
                        <WrapPanel x:Name="CardQuickActionsPanel"
                                   Grid.Row="1" Grid.ColumnSpan="2"
                                   Margin="0,5,0,0"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center">
                            <Button Content="{Binding ExpandButtonText}"
                                    Command="{Binding ToggleExpandedCommand}"
                                    Height="22" Padding="8,0" Margin="0,0,6,0" FontSize="11"
                                    Background="{DynamicResource ButtonBgBrush}" Foreground="{DynamicResource ButtonFgBrush}"
                                    BorderThickness="1" BorderBrush="{DynamicResource LineMutedBrush}"
                                    Cursor="Hand" VerticalAlignment="Center"
                                    ToolTip="{Binding ExpandButtonTooltip}"
                                    AutomationProperties.Name="{Binding ExpandButtonAutomationName}"/>

                            <!-- If in Trash: Restore & Permanent Delete buttons -->
                            <Button Content="Восстановить" Command="{Binding RestoreCommand}"
                                    Height="22" Padding="6,0" Margin="0,0,6,0" FontSize="11"
                                    Background="{DynamicResource SuccessBannerBgBrush}" Foreground="{DynamicResource SuccessBannerFgBrush}" FontWeight="Medium" ToolTip="Восстановить из корзины">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsDeleted}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>

                            <Button Content="Удалить" Command="{Binding PermanentDeleteCommand}"
                                    Height="22" Padding="6,0" Margin="0,0,8,0" FontSize="11"
                                    Background="{DynamicResource ErrorBannerBgBrush}" Foreground="{DynamicResource ErrorBannerFgBrush}" FontWeight="Medium" ToolTip="Удалить навсегда">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsDeleted}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>

                            <!-- If Inbox: Mark processed button -->
                            <Button Content="✓ Обработано" Command="{Binding MarkProcessedAndNextCommand}"
                                    Height="22" Padding="6,0" Margin="0,0,6,0" FontSize="11"
                                    Background="{DynamicResource SuccessBannerBgBrush}" Foreground="{DynamicResource SuccessBannerFgBrush}" FontWeight="Medium" ToolTip="Отметить как обработанную и перейти к следующей входящей (Ctrl+Enter)">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding IsInbox}" Value="True"/>
                                                    <Condition Binding="{Binding IsDeleted}" Value="False"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>

                            <!-- Pin button -->
                            <Button Command="{Binding TogglePinCommand}"
                                    Width="24" Height="22" Margin="0,0,2,0" Padding="0"
                                    Background="Transparent" BorderThickness="0" Cursor="Hand" ToolTip="{Binding PinTooltip}">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsDeleted}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <TextBlock FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="{Binding PinSymbol}"/>
                                            <Setter Property="Opacity" Value="0.35"/>
                                            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsPinned}" Value="True">
                                                    <Setter Property="Opacity" Value="1.0"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Button>

                            <!-- Favorite star button -->
                            <Button Command="{Binding ToggleFavoriteCommand}"
                                    Width="24" Height="22" Margin="0,0,6,0" Padding="0"
                                    Background="Transparent" BorderThickness="0" Cursor="Hand" ToolTip="{Binding FavoriteTooltip}">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsDeleted}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <TextBlock FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="☆"/>
                                            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                                                    <Setter Property="Text" Value="★"/>
                                                    <Setter Property="Foreground" Value="#F59E0B"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Button>

                            <!-- Indicator arrow for expanded state -->
                            <TextBlock FontSize="11" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="4,0,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="▼"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                                <Setter Property="Text" Value="▲"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </WrapPanel>
                    </Grid>
                 </Border>

                <!-- Source info: compact bar if present -->
                <Border Grid.Row="1" Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Padding="14,4">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasSourceText}" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Источник: " FontSize="11" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding SourceText}" FontSize="11" Foreground="{DynamicResource InkBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip="{Binding SourceText}"/>
                    </StackPanel>
                </Border>

                <!-- Card body: single click selects (handler on CardBorder). List: Enter opens in pane; Board: Ctrl+E opens in window (UX-C14 / W2). -->
                <Border Grid.Row="2" Background="{DynamicResource CardBgBrush}" Padding="14,10" Cursor="IBeam">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="ToolTip" Value="{x:Static h:CardGestureCopy.BodyTooltip}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding DataContext.WorkspaceViewMode, RelativeSource={RelativeSource AncestorType=Window}}" Value="Board">
                                    <Setter Property="ToolTip" Value="{x:Static h:CardGestureCopy.BoardBodyTooltip}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock TextWrapping="Wrap"
                               FontSize="13" FontFamily="Segoe UI, Arial" LineHeight="19" Foreground="{DynamicResource InkBrush}"
                               h:HighlightText.Source="{Binding PreviewText}"
                               h:HighlightText.Query="{Binding HighlightQuery}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="MaxHeight" Value="{Binding PreviewMaxHeight}"/>
                                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                        <Setter Property="TextTrimming" Value="None"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Border>

                <!-- 11.3. ПОДВАЛ С ТЕГАМИ: badges / chips -->
                <Border Grid.Row="3" Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0"
                        CornerRadius="0,0,8,8" Padding="12,6">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Tags.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <ItemsControl ItemsSource="{Binding Tags}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource BadgeBgBrush}" BorderBrush="{DynamicResource LineMutedBrush}" BorderThickness="1" CornerRadius="10"
                                        Margin="0,2,6,2" Padding="8,2">
                                     <TextBlock Text="{Binding}" FontSize="11" Foreground="{DynamicResource BadgeFgBrush}" FontWeight="Medium"/>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
            </Grid>
        </Border>
    </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Top Bar -->
            <RowDefinition Height="*"/>    <!-- Main 2-Panel Area -->
            <RowDefinition Height="Auto"/> <!-- Status Bar -->
        </Grid.RowDefinitions>

        <!-- TOP BAR -->
        <Border Grid.Row="0" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Padding="14,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="200"/>
                    <ColumnDefinition Width="*" MinWidth="280"/>
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <!-- Search Input -->
                <Border Grid.Row="0" Grid.Column="0" Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="8" Height="30" Margin="0,0,16,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="⌕" VerticalAlignment="Center" Margin="11,0,4,0" FontSize="21" Foreground="{DynamicResource MutedBrush}"/>

                        <TextBox Grid.Column="1" Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                 VerticalContentAlignment="Center" BorderThickness="0" Background="Transparent"
                                 FontSize="13" Padding="4,0" x:Name="SearchBox" TabIndex="1"
                                 CaretBrush="{DynamicResource InkBrush}"
                                 AutomationProperties.Name="Поиск заметок"
                                 ToolTip="Поиск по заметкам (Ctrl+F, F6). Примеры: tag:работа, created:today, source:chrome, url:https"/>

                        <!-- Placeholder -->
                        <TextBlock Grid.Column="1" Text="Найти заметку…"
                                   VerticalAlignment="Center" Margin="6,0,0,0"
                                   FontSize="13" Foreground="{DynamicResource MutedBrush}" IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <Button x:Name="SearchHelpButton" Grid.Column="2"
                                Click="SearchHelpButton_Click"
                                Content="?" Width="24" Height="24" Margin="0,0,2,0"
                                Background="Transparent" Foreground="{DynamicResource MutedBrush}" BorderThickness="0"
                                FontSize="13" FontWeight="Bold" Cursor="Hand"
                                ToolTip="Примеры расширенного поиска" KeyboardNavigation.IsTabStop="False"/>

                        <!-- Clear search button -->
                        <Button Grid.Column="3" Content="×" Command="{Binding ClearSearchCommand}"
                                Width="24" Height="24" Margin="0,0,4,0"
                                Background="Transparent" Foreground="{DynamicResource MutedBrush}" BorderThickness="0"
                                FontSize="14" FontWeight="Bold" Cursor="Hand" ToolTip="Очистить поиск (Esc)"
                                KeyboardNavigation.IsTabStop="False">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Grid>
                </Border>

                <!-- Action Buttons: search + create stay visible; rare commands live in «Ещё». -->
                <WrapPanel Grid.Row="0" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <!-- Workspace representation toggle: Доска / Список (default Список) -->
                    <ToggleButton x:Name="WorkspaceModeToggle"
                                  IsChecked="{Binding IsBoardMode, Mode=TwoWay}"
                                  Height="30" Margin="0,0,8,0"
                                  Cursor="Hand"
                                  TabIndex="0"
                                  KeyboardNavigation.IsTabStop="True"
                                  AutomationProperties.Name="Представление рабочего пространства: Доска или Список"
                                  ToolTip="Переключить представление рабочего пространства: Доска / Список">
                        <ToggleButton.Template>
                            <ControlTemplate TargetType="ToggleButton">
                                <Border x:Name="ModeChrome"
                                        Background="{DynamicResource SurfaceAltBrush}"
                                        BorderBrush="{DynamicResource LineBrush}"
                                        BorderThickness="1"
                                        CornerRadius="9"
                                        SnapsToDevicePixels="True">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border x:Name="ListSegment" Grid.Column="0" Padding="12,0"
                                                CornerRadius="8,0,0,8" Background="{DynamicResource AccentBrush}">
                                            <TextBlock x:Name="ListSegmentText" Text="Список" FontSize="13" FontWeight="Medium"
                                                       Foreground="White" VerticalAlignment="Center"/>
                                        </Border>
                                        <Border x:Name="BoardSegment" Grid.Column="1" Padding="12,0"
                                                CornerRadius="0,8,8,0" Background="Transparent">
                                            <TextBlock x:Name="BoardSegmentText" Text="Доска" FontSize="13" FontWeight="Medium"
                                                       Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
                                        </Border>
                                    </Grid>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter TargetName="ListSegment" Property="Background" Value="Transparent"/>
                                        <Setter TargetName="ListSegmentText" Property="Foreground" Value="{DynamicResource MutedBrush}"/>
                                        <Setter TargetName="BoardSegment" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                        <Setter TargetName="BoardSegmentText" Property="Foreground" Value="White"/>
                                    </Trigger>
                                    <Trigger Property="IsKeyboardFocused" Value="True">
                                        <Setter TargetName="ModeChrome" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                        <Setter TargetName="ModeChrome" Property="BorderThickness" Value="2"/>
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="ModeChrome" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </ToggleButton.Template>
                    </ToggleButton>

                    <Button Content="Сбросить" Command="{Binding ResetFilterCommand}"
                            Height="30" Padding="12,0" Margin="0,0,8,0"
                            Background="{DynamicResource ButtonBgBrush}" Foreground="{DynamicResource ButtonFgBrush}" FontWeight="Medium"
                            ToolTip="Сбросить поиск, тег и раздел"
                            AutomationProperties.Name="Сбросить фильтр">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasActiveFilter}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Button Content="Очистить корзину" Command="{Binding EmptyTrashCommand}"
                            Height="30" Padding="12,0" Margin="0,0,8,0"
                            Background="{DynamicResource ErrorBannerBgBrush}" Foreground="{DynamicResource ErrorBannerFgBrush}" FontWeight="Medium"
                            ToolTip="Очистить корзину (удалить все заметки из корзины)"
                            KeyboardNavigation.IsTabStop="False">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsTrashSelected}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Button Content="{Binding ConflictBadgeText}" Command="{Binding OpenSyncConflictsCommand}"
                            Height="30" Padding="12,0" Margin="0,0,8,0"
                            Background="{DynamicResource WarningBannerBgBrush}" Foreground="{DynamicResource WarningBannerFgBrush}" FontWeight="SemiBold"
                            ToolTip="Обнаружены конфликты одновременных изменений. Нажмите для разрешения."
                            KeyboardNavigation.IsTabStop="False">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasUnresolvedConflicts}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Button Content="{Binding ScreenOcrButtonText}" Command="{Binding ScreenOcrCommand}"
                            Height="30" Padding="12,0" Margin="0,0,8,0"
                            Background="{DynamicResource ButtonBgBrush}" Foreground="{DynamicResource ButtonFgBrush}" FontWeight="Medium"
                            ToolTip="{Binding ScreenOcrButtonToolTip}" KeyboardNavigation.IsTabStop="False"/>

                    <Button x:Name="FullscreenButton"
                            Content="{Binding FullscreenButtonText}" Command="{Binding ToggleFullscreenCommand}"
                            Height="30" Padding="12,0" Margin="0,0,8,0"
                            Background="{DynamicResource ButtonBgBrush}" Foreground="{DynamicResource ButtonFgBrush}" FontWeight="Medium"
                            ToolTip="{Binding FullscreenButtonTooltip}"
                            AutomationProperties.Name="{Binding FullscreenButtonTooltip}"
                            KeyboardNavigation.IsTabStop="False"/>

                    <Button x:Name="MoreMenuButton" Content="Ещё ▾" Click="MoreMenuButton_Click"
                            Height="30" Padding="12,0" Margin="0,0,8,0"
                            Background="{DynamicResource ButtonBgBrush}" Foreground="{DynamicResource ButtonFgBrush}" FontWeight="Medium"
                            ToolTip="Дополнительные команды: синхронизация, настройки, импорт и обслуживание (Alt+M)"
                            KeyboardNavigation.IsTabStop="False"/>

                    <!-- New Note Split Button -->
                    <Border x:Name="NewNoteSplitRoot"
                            Background="{DynamicResource AccentBrush}"
                            CornerRadius="6" Height="30" Margin="0" SnapsToDevicePixels="True">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="1"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Button x:Name="NewNoteButton" Grid.Column="0"
                                    Click="NewNoteButton_Click"
                                    MouseRightButtonUp="NewNoteButton_MouseRightButtonUp"
                                    Height="30" Padding="14,0,10,0"
                                    Background="Transparent" Foreground="White" FontWeight="SemiBold"
                                    ToolTip="Новая пустая заметка (Ctrl+N). Правый клик — шаблоны"
                                    AutomationProperties.Name="Новая заметка">
                                <TextBlock Text="Новая заметка" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </Button>

                            <Rectangle Grid.Column="1" Fill="#33FFFFFF" VerticalAlignment="Stretch" Margin="0,6"/>

                            <Button x:Name="NewNoteDropdownButton" Grid.Column="2"
                                    Click="NewNoteDropdownButton_Click"
                                    Height="30" Padding="8,0,10,0"
                                    Background="Transparent" Foreground="White"
                                    ToolTip="Меню шаблонов заметок (выбор и управление)"
                                    KeyboardNavigation.IsTabStop="False">
                                <TextBlock Text="▾" FontWeight="Bold" FontSize="11" VerticalAlignment="Center"/>
                            </Button>
                        </Grid>
                    </Border>
                </WrapPanel>

                <!-- Active Filter Chips -->
                <ItemsControl Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                              ItemsSource="{Binding ActiveFilterChips}"
                              Margin="0,8,0,0">
                    <ItemsControl.Style>
                        <Style TargetType="ItemsControl">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ActiveFilterChips.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ItemsControl.Style>
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource BadgeBgBrush}" BorderBrush="{DynamicResource LineMutedBrush}" BorderThickness="1"
                                    CornerRadius="12" Padding="8,2,4,2" Margin="0,0,6,4"
                                    VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding DisplayText}" FontSize="12" Foreground="{DynamicResource BadgeFgBrush}"
                                               VerticalAlignment="Center" Margin="0,0,4,0"/>
                                    <Button Command="{Binding RemoveCommand}"
                                            Content="×" FontSize="13" FontWeight="Bold"
                                            Foreground="{DynamicResource MutedBrush}" Background="Transparent"
                                            BorderThickness="0" Cursor="Hand"
                                            Width="16" Height="16" Padding="0"
                                            VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                                            ToolTip="Удалить условие">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Opacity" Value="0.7"/>
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Opacity" Value="1.0"/>
                                                        <Setter Property="Foreground" Value="{DynamicResource ErrorBannerFgBrush}"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </Border>

        <!-- MAIN 3-PANE WORKSPACE AREA -->
        <Grid Grid.Row="1" x:Name="MainWorkspaceGrid">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="NavCol" Width="240" MinWidth="200" MaxWidth="280"/>
                <ColumnDefinition x:Name="NavSplitterCol" Width="Auto"/>
                <ColumnDefinition x:Name="ListCol" Width="350" MinWidth="350" MaxWidth="480"/>
                <ColumnDefinition x:Name="DetailSplitterCol" Width="Auto"/>
                <ColumnDefinition x:Name="DetailCol" Width="*" MinWidth="250"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT PANEL: VIRTUAL SECTIONS + TAG TREE -->
            <Border x:Name="NavBorder" Grid.Column="0" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Virtual Sections List -->
                        <RowDefinition Height="Auto"/> <!-- Saved Views -->
                        <RowDefinition Height="Auto"/> <!-- Tag Tree Header -->
                        <RowDefinition Height="Auto"/> <!-- Selected Tag Breadcrumb -->
                        <RowDefinition Height="*"/>    <!-- TreeView -->
                    </Grid.RowDefinitions>

                    <!-- 1. VIRTUAL SECTIONS LIST -->
                    <Border Grid.Row="0" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Padding="8,8,8,6">
                        <ListBox x:Name="VirtualSectionsList"
                                 ItemsSource="{Binding VirtualSections}"
                                 SelectedItem="{Binding SelectedSection, Mode=TwoWay}"
                                 BorderThickness="0" Background="Transparent" Padding="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                 KeyboardNavigation.TabNavigation="Once"
                                 AutomationProperties.Name="Разделы заметок">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="ItemChrome" Background="Transparent" BorderBrush="Transparent"
                                                        BorderThickness="2" CornerRadius="6" Margin="0,1" Padding="8,5"
                                                        SnapsToDevicePixels="True">
                                                    <ContentPresenter/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ItemChrome" Property="Background" Value="{DynamicResource SurfaceAltBrush}"/>
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="ItemChrome" Property="Background" Value="{DynamicResource CardSelectedBgBrush}"/>
                                                    </Trigger>
                                                    <Trigger Property="IsKeyboardFocused" Value="True">
                                                        <Setter TargetName="ItemChrome" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid AutomationProperties.Name="{Binding Title}" ToolTip="{Binding Title}">
                                        <!-- Normal presentation: Title and Badge -->
                                        <Grid x:Name="NormalSectionGrid">
                                            <Grid.Style>
                                                <Style TargetType="Grid">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding DataContext.IsCompactNav, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Grid.Style>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource InkBrush}" VerticalAlignment="Center"/>
                                                <TextBlock Text="из текста заметок" FontSize="10" Foreground="{DynamicResource MutedBrush}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsTaskIndex}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>

                                            <Border Grid.Column="1" Background="{DynamicResource AccentBrush}" CornerRadius="9" Padding="6,1" VerticalAlignment="Center">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasBadge}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding BadgeText}" FontSize="11" FontWeight="Bold" Foreground="White"/>
                                            </Border>
                                        </Grid>

                                        <!-- Compact presentation: Centered Icon/Short text with Badge indicator -->
                                        <Grid x:Name="CompactSectionGrid">
                                            <Grid.Style>
                                                <Style TargetType="Grid">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding DataContext.IsCompactNav, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Grid.Style>
                                            <TextBlock Text="{Binding CompactText}" FontSize="12" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource InkBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            <Border Background="{DynamicResource AccentBrush}" CornerRadius="5" MinWidth="10" Height="10"
                                                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-2,-2,0">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasBadge}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                            </Border>
                                        </Grid>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>

                    <!-- 2. SAVED VIEWS -->
                    <Border Grid.Row="1" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Padding="8,8,8,6">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCompactNav}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Сохранённые виды" FontWeight="SemiBold" FontSize="13"
                                           Foreground="{DynamicResource InkBrush}" VerticalAlignment="Center"
                                           ToolTip="Именованные фильтры над заметками. Вид не копирует заметки."/>
                                <Button Grid.Column="1" x:Name="SaveCurrentViewButton" Content="Сохранить вид"
                                        Command="{Binding SaveCurrentViewCommand}"
                                        Height="24" Padding="8,0" FontSize="11"
                                        Background="{DynamicResource ButtonBgBrush}" Foreground="{DynamicResource ButtonFgBrush}"
                                        BorderThickness="0" Cursor="Hand"
                                        ToolTip="Сохранить текущий фильтр как новый вид"
                                        AutomationProperties.Name="Сохранить текущий вид"/>
                            </Grid>
                            <ListBox x:Name="SavedViewsList"
                                     ItemsSource="{Binding SavedViews}"
                                     BorderThickness="0" Background="Transparent" Padding="0" Margin="0,6,0,0"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     KeyboardNavigation.TabNavigation="Once"
                                     AutomationProperties.Name="Сохранённые виды">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Padding" Value="0"/>
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border x:Name="ItemChrome" Background="Transparent" BorderBrush="Transparent"
                                                            BorderThickness="2" CornerRadius="6" Margin="0,1" Padding="8,4"
                                                            SnapsToDevicePixels="True">
                                                        <ContentPresenter/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="ItemChrome" Property="Background" Value="{DynamicResource SurfaceAltBrush}"/>
                                                        </Trigger>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter TargetName="ItemChrome" Property="Background" Value="{DynamicResource CardSelectedBgBrush}"/>
                                                        </Trigger>
                                                        <Trigger Property="IsKeyboardFocused" Value="True">
                                                            <Setter TargetName="ItemChrome" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="13"
                                                       Foreground="{DynamicResource InkBrush}" VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding Tooltip}"/>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                <Button x:Name="ApplySavedViewButton" Content="Применить"
                                                        Command="{Binding DataContext.ApplySavedViewCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"
                                                        Height="22" Padding="6,0" FontSize="11" Margin="0,0,4,0"
                                                        Background="{DynamicResource ButtonBgBrush}" Foreground="{DynamicResource ButtonFgBrush}"
                                                        BorderThickness="0" Cursor="Hand"
                                                        ToolTip="Применить этот фильтр к списку заметок"
                                                        AutomationProperties.Name="Применить сохранённый вид"/>
                                                <Button x:Name="RenameSavedViewButton" Content="…"
                                                        Command="{Binding DataContext.RenameSavedViewCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"
                                                        Height="22" Width="22" Padding="0" FontSize="11" Margin="0,0,4,0"
                                                        Background="{DynamicResource ButtonBgBrush}" Foreground="{DynamicResource ButtonFgBrush}"
                                                        BorderThickness="0" Cursor="Hand"
                                                        ToolTip="Переименовать вид"
                                                        AutomationProperties.Name="Переименовать сохранённый вид"/>
                                                <Button x:Name="DeleteSavedViewButton" Content="Удалить вид"
                                                        Command="{Binding DataContext.DeleteSavedViewCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"
                                                        Height="22" Padding="6,0" FontSize="11"
                                                        Background="{DynamicResource ButtonBgBrush}" Foreground="{DynamicResource ButtonFgBrush}"
                                                        BorderThickness="0" Cursor="Hand"
                                                        ToolTip="Удалить вид (заметки останутся)"
                                                        AutomationProperties.Name="Удалить сохранённый вид"/>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock Text="Видов пока нет" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="2,6,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasSavedViews}" Value="False">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- 3. TAG TREE HEADER -->
                    <Border Grid.Row="2" Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Padding="16,10">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCompactNav}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Теги" FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource InkBrush}"/>
                                <TextBlock Text="  ·  дерево" FontSize="11" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Content="Предложить" Command="{Binding SuggestTagsCommand}"
                                        Height="24" Padding="8,0" Margin="0,0,6,0" FontSize="11"
                                        Background="{DynamicResource ButtonBgBrush}" Foreground="{DynamicResource ButtonFgBrush}"
                                        ToolTip="Предложить новые теги по часто повторяющимся словам" KeyboardNavigation.IsTabStop="False"/>
                                <Button Content="Новый тег" Command="{Binding AddRootTagCommand}"
                                        Height="24" Padding="8,0" FontSize="11"
                                        Background="{DynamicResource ButtonBgBrush}" Foreground="{DynamicResource ButtonFgBrush}" BorderThickness="0" Cursor="Hand"
                                        ToolTip="Добавить корневой тег"
                                        AutomationProperties.Name="Новый корневой тег"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- 3. SELECTED TAG BREADCRUMB BAR -->
                    <Border Grid.Row="3" Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Padding="12,6">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding HasSelectedTag}" Value="True"/>
                                            <Condition Binding="{Binding IsCompactNav}" Value="False"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Путь: " FontSize="11" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{Binding SelectedTagFullPath}" FontSize="11" FontWeight="Medium" Foreground="{DynamicResource InkBrush}"
                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding SelectedTagFullPath}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="{Binding SelectedTag.NoteCount, StringFormat='({0})'}" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="4,0,0,0" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- 4. TREEVIEW -->
                    <TreeView Grid.Row="4" ItemsSource="{Binding TagTreeRoots}"
                              BorderThickness="0" Background="Transparent" Padding="4"
                              SelectedItemChanged="TagTreeView_SelectedItemChanged"
                              PreviewMouseLeftButtonDown="TagTreeView_PreviewMouseLeftButtonDown"
                              PreviewMouseMove="TagTreeView_PreviewMouseMove"
                              PreviewMouseLeftButtonUp="TagTreeView_PreviewMouseLeftButtonUp"
                              DragOver="TagTreeView_DragOver"
                              DragLeave="TagTreeView_DragLeave"
                              Drop="TagTreeView_Drop"
                              AllowDrop="True"
                              x:Name="TagTree">
                        <TreeView.Style>
                            <Style TargetType="TreeView">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCompactNav}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TreeView.Style>
                        <TreeView.ItemContainerStyle>
                            <Style TargetType="TreeViewItem">
                                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                                <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
                                <Setter Property="Padding" Value="2,3"/>
                                <Setter Property="FontSize" Value="13"/>
                            </Style>
                        </TreeView.ItemContainerStyle>
                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                <Border CornerRadius="4" Padding="3,2" Margin="1,0">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsDropTarget}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource CardSelectedBgBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel Orientation="Horizontal" Margin="2,1"
                                                Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}"
                                                ToolTip="{Binding FullPath}">
                                        <StackPanel.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="Добавить подтег"
                                                          Command="{Binding PlacementTarget.Tag.AddChildTagCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                          CommandParameter="{Binding}"/>
                                                <MenuItem Header="Переименовать"
                                                          Command="{Binding PlacementTarget.Tag.RenameTagCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                          CommandParameter="{Binding}"/>
                                                <MenuItem Header="Изменить родителя"
                                                          Command="{Binding PlacementTarget.Tag.ChangeParentTagCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                          CommandParameter="{Binding}"/>
                                                <MenuItem Header="Управление синонимами"
                                                          Command="{Binding PlacementTarget.Tag.ManageSynonymsCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                          CommandParameter="{Binding}"/>
                                                <MenuItem Header="Правила автотега…"
                                                          Command="{Binding PlacementTarget.Tag.ManageRulesCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                          CommandParameter="{Binding}"/>
                                                <MenuItem Header="Объединить с…"
                                                          Command="{Binding PlacementTarget.Tag.MergeTagCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                          CommandParameter="{Binding}"/>
                                                <Separator/>
                                                <MenuItem Header="Удалить тег"
                                                          Command="{Binding PlacementTarget.Tag.DeleteTagCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                          CommandParameter="{Binding}"/>
                                            </ContextMenu>
                                        </StackPanel.ContextMenu>
                                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center" Foreground="{DynamicResource InkBrush}"/>
                                        <Border Background="{DynamicResource BadgeBgBrush}" CornerRadius="8" Padding="5,0" Margin="6,0,0,0" VerticalAlignment="Center" MinWidth="18">
                                            <TextBlock Text="{Binding NoteCount}" FontSize="10" Foreground="{DynamicResource BadgeFgBrush}" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                </Grid>
            </Border>

            <!-- Nav Splitter -->
            <GridSplitter x:Name="NavSplitter" Grid.Column="1" Width="6" HorizontalAlignment="Stretch"
                          Background="Transparent" ResizeDirection="Columns"
                          Cursor="SizeWE" DragCompleted="NavSplitter_DragCompleted"
                          AutomationProperties.Name="Разделитель панели навигации"
                          ToolTip="Изменить ширину навигации"/>

            <!-- RIGHT PANEL: NOTE CARDS LIST -->
            <Grid x:Name="NotesListGrid" Grid.Column="2" Background="{DynamicResource CanvasBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Header / Sorting Bar -->
                    <RowDefinition Height="*"/>    <!-- Cards list / Empty state -->
                </Grid.RowDefinitions>

                <!-- HEADER / SORTING TOOLBAR -->
                <Border Grid.Row="0" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}"
                        BorderThickness="0,0,0,1" Padding="12,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left: Section / Tag info -->
                        <StackPanel VerticalAlignment="Center" Margin="0,0,6,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="NotesHeaderTitleBlock" Text="{Binding NotesHeaderTitle}" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{DynamicResource InkBrush}" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding NotesHeaderTitle}"/>
                                <TextBlock Text="{Binding CurrentListCount, StringFormat=' ({0})'}" FontSize="12"
                                           Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock x:Name="TaskRemindersStatusText"
                                       Text="{Binding TaskRemindersStatusText}"
                                       FontSize="11" Foreground="{DynamicResource MutedBrush}"
                                       TextWrapping="Wrap" Margin="0,4,0,0"
                                       AutomationProperties.Name="Статус локальных напоминаний"
                                       ToolTip="Локальные напоминания Windows для задач с датой">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsTasksSelected}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>

                        <!-- Right: Sort control -->
                        <ComboBox x:Name="SortComboBox" Grid.Column="1"
                                  ItemsSource="{Binding AvailableSortModes}"
                                  SelectedItem="{Binding SelectedSortModeItem}"
                                  DisplayMemberPath="Title"
                                  Width="150" Height="28"
                                  VerticalContentAlignment="Center"
                                  FontSize="12"
                                  TabIndex="2"
                                  AutomationProperties.Name="Сортировка заметок"
                                  ToolTip="Сортировка заметок (Alt+↓/↑ для навигации)">
                            <ComboBox.Style>
                                <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsTasksSelected}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ComboBox.Style>
                        </ComboBox>
                    </Grid>
                </Border>

                <!-- Cards list and empty state container (Grid.Row="1") -->
                <Grid Grid.Row="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Empty state when no notes -->
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="20">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ShowNotesEmptyState}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <Border Width="64" Height="64" CornerRadius="20" Background="{DynamicResource CardSelectedBgBrush}" HorizontalAlignment="Center" Margin="0,0,0,14">
                            <TextBlock Text="✎" FontSize="32" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="{Binding EmptyStateTitle}" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding EmptyStateDescription}"
                                   FontSize="13" Foreground="{DynamicResource MutedBrush}" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="360" Margin="0,6,0,8"/>
                        <TextBlock Text="{Binding EmptyStateProtectedHint}"
                                   FontSize="12" Foreground="{DynamicResource MutedBrush}" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="360" Margin="0,0,0,12">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ShowProtectedSearchHint}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <Button Content="Сбросить фильтр" Command="{Binding ResetFilterCommand}"
                                Height="32" Padding="14,0" HorizontalAlignment="Center" Margin="0,0,0,8"
                                Background="{DynamicResource ButtonBgBrush}" Foreground="{DynamicResource ButtonFgBrush}" FontWeight="Medium" BorderThickness="0" Cursor="Hand"
                                AutomationProperties.Name="Сбросить фильтр">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ShowEmptyStateResetFilter}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="Создать заметку" Command="{Binding NewNoteCommand}"
                                Height="32" Padding="14,0" HorizontalAlignment="Center"
                                Background="{DynamicResource AccentBrush}" Foreground="White" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand"
                                AutomationProperties.Name="Создать заметку">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsTrashSelected}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsTasksSelected}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>

                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="20">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ShowTasksEmptyState}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <Border Width="64" Height="64" CornerRadius="20" Background="{DynamicResource CardSelectedBgBrush}" HorizontalAlignment="Center" Margin="0,0,0,14">
                            <TextBlock Text="☐" FontSize="32" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock x:Name="TasksEmptyTitleBlock" Text="{Binding EmptyStateTitle}" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding EmptyStateDescription}"
                                   FontSize="13" Foreground="{DynamicResource MutedBrush}" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="360" Margin="0,6,0,8"/>
                        <Button Content="Сбросить фильтр" Command="{Binding ResetFilterCommand}"
                                Height="32" Padding="14,0" HorizontalAlignment="Center"
                                Background="{DynamicResource ButtonBgBrush}" Foreground="{DynamicResource ButtonFgBrush}" FontWeight="Medium" BorderThickness="0" Cursor="Hand"
                                AutomationProperties.Name="Сбросить фильтр">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ShowEmptyStateResetFilter}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>

                    <!-- Scrollable list of cards -->
                    <ListBox x:Name="NotesListBox" Grid.Row="0" ItemsSource="{Binding Notes}"
                             SelectedItem="{Binding SelectedNote, Mode=TwoWay}"
                             Background="Transparent" BorderThickness="0" Padding="14,10"
                             TabIndex="3"
                             ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.CanContentScroll="True" VirtualizingPanel.ScrollUnit="Pixel"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling">
                        <ListBox.Style>
                            <Style TargetType="ListBox">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Notes.Count}" Value="0">
                                        <Setter Property="IsHitTestVisible" Value="False"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsTasksSelected}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ListBox.Style>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <ContentPresenter/>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <StaticResource ResourceKey="NoteCardItemTemplate"/>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <ListBox x:Name="TasksListBox" Grid.Row="0" ItemsSource="{Binding Tasks}"
                             SelectedItem="{Binding SelectedTask, Mode=TwoWay}"
                             Background="Transparent" BorderThickness="0" Padding="14,10"
                             TabIndex="3"
                             AutomationProperties.Name="Список открытых задач"
                             ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.CanContentScroll="True" VirtualizingPanel.ScrollUnit="Pixel"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling"
                             ItemTemplate="{StaticResource TaskItemTemplate}">
                        <ListBox.Style>
                            <Style TargetType="ListBox">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsTasksSelected}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ListBox.Style>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="AutomationProperties.Name" Value="{Binding AccessibilityName}"/>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>

                    <!-- Load more continuation footer -->
                    <Border Grid.Row="1" Margin="14,4,14,8" HorizontalAlignment="Center">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasMoreNotes}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Button x:Name="LoadMoreNotesButton"
                                Content="{Binding LoadMoreButtonText}"
                                Command="{Binding LoadMoreNotesCommand}"
                                Height="30" Padding="18,0"
                                Background="{DynamicResource ButtonBgBrush}"
                                Foreground="{DynamicResource ButtonFgBrush}"
                                BorderThickness="1"
                                BorderBrush="{DynamicResource LineBrush}"
                                FontWeight="SemiBold"
                                Cursor="Hand"
                                ToolTip="Загрузить следующие заметки"
                                AutomationProperties.Name="Загрузить ещё задачи или заметки"/>
                    </Border>
                </Grid>
            </Grid>

            <!-- DETAIL SPLITTER -->
            <GridSplitter x:Name="DetailSplitter" Grid.Column="3" Width="6" HorizontalAlignment="Stretch"
                          Background="Transparent" ResizeDirection="Columns"
                          Cursor="SizeWE" DragCompleted="DetailSplitter_DragCompleted"
                          AutomationProperties.Name="Разделитель панели деталей"
                          ToolTip="Изменить ширину редактора"/>

            <!-- DETAIL PANE -->
            <Border x:Name="DetailPaneBorder" Grid.Column="4" Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource LineBrush}" BorderThickness="1,0,0,0">
                <Grid>
                    <!-- Empty State (when DetailEditor is null) -->
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="32" MaxWidth="340">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DetailEditor}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <Border Width="60" Height="60" CornerRadius="18" Background="{DynamicResource CardSelectedBgBrush}"
                                HorizontalAlignment="Center" Margin="0,0,0,16">
                            <TextBlock Text="📝" FontSize="28" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Заметка не выбрана" FontSize="16" FontWeight="SemiBold"
                                   Foreground="{DynamicResource InkBrush}" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                        <TextBlock Text="Выберите заметку в списке или создайте новую."
                                   FontSize="13" Foreground="{DynamicResource MutedBrush}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,18"/>
                        <Button Content="+ Новая заметка" Command="{Binding CreateEmptyNoteCommand}"
                                Height="32" Padding="16,0" Background="{DynamicResource AccentBrush}" Foreground="White"
                                FontWeight="SemiBold" HorizontalAlignment="Center" Cursor="Hand"
                                AutomationProperties.Name="Создать новую заметку"/>
                    </StackPanel>

                    <!-- Active Detail Content -->
                    <Grid DataContext="{Binding DetailEditor}" Margin="16,12">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/> <!-- Header / Action Bar -->
                            <RowDefinition Height="Auto"/> <!-- Source info / draft banner -->
                            <RowDefinition Height="Auto"/> <!-- Title field -->
                            <RowDefinition Height="*"/>    <!-- Editor / Preview / Locked -->
                            <RowDefinition Height="Auto"/> <!-- Active tags bar -->
                        </Grid.RowDefinitions>

                        <!-- Header & Action Bar -->
                        <Grid Grid.Row="0" Margin="0,0,0,10" x:Name="DetailHeaderBar">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/> <!-- Back button -->
                                <ColumnDefinition Width="*"/>    <!-- Actions WrapPanel -->
                            </Grid.ColumnDefinitions>

                            <!-- Back button in narrow mode -->
                            <Button x:Name="BackToMasterButton" Grid.Column="0"
                                    Visibility="Collapsed"
                                    Command="{Binding DataContext.BackToMasterCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    Height="30" Padding="10,0" Margin="0,0,8,0"
                                    Background="{DynamicResource ButtonBgBrush}" Foreground="{DynamicResource ButtonFgBrush}"
                                    FontWeight="SemiBold" Cursor="Hand"
                                    ToolTip="Назад к списку (Esc / Alt+←)"
                                    AutomationProperties.Name="Назад к списку">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="←" FontWeight="Bold" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Назад" FontWeight="Medium" FontSize="12" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <!-- Responsive Action buttons container -->
                            <WrapPanel x:Name="DetailActionWrapPanel" Grid.Column="1" Orientation="Horizontal"
                                       HorizontalAlignment="Right" VerticalAlignment="Center">
                                <!-- Mode switcher: Text / Split / Preview -->
                                <Border x:Name="DetailModeSwitcher" Background="{DynamicResource ButtonBgBrush}" CornerRadius="8" Padding="2" Margin="0,0,6,2">
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="Текст" Command="{Binding ShowTextModeCommand}"
                                                Height="24" Padding="7,0" BorderThickness="0" Cursor="Hand" ToolTip="Режим текста (Ctrl+P)"
                                                AutomationProperties.Name="Режим текста">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Background" Value="Transparent"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource ButtonFgBrush}"/>
                                                    <Setter Property="FontWeight" Value="Normal"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsEditMode}" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
                                                            <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
                                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                        <Button Content="Раздельно" Command="{Binding ShowSplitModeCommand}"
                                                Height="24" Padding="7,0" BorderThickness="0" Cursor="Hand" ToolTip="Редактор и предпросмотр вместе"
                                                AutomationProperties.Name="Раздельный режим">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Background" Value="Transparent"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource ButtonFgBrush}"/>
                                                    <Setter Property="FontWeight" Value="Normal"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSplitMode}" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
                                                            <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
                                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                        <Button Content="Предпросмотр" Command="{Binding ShowPreviewModeCommand}"
                                                Height="24" Padding="7,0" BorderThickness="0" Cursor="Hand" ToolTip="Предпросмотр Markdown (Ctrl+P)"
                                                AutomationProperties.Name="Режим предпросмотра">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Background" Value="Transparent"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource ButtonFgBrush}"/>
                                                    <Setter Property="FontWeight" Value="Normal"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsPreviewMode}" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
                                                            <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
                                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </StackPanel>
                                </Border>

                                <!-- Markdown formatting toolbar -->
                                <Border x:Name="DetailFormattingToolbar" Background="{DynamicResource ButtonBgBrush}" CornerRadius="8" Padding="2" Margin="0,0,4,2">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsPreviewMode}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel Orientation="Horizontal">
                                        <Button x:Name="FormatBoldButton" Style="{StaticResource FormattingToolbarButtonStyle}"
                                                Content="B" Command="{Binding ToggleBoldCommand}" FontWeight="Bold"
                                                ToolTip="{x:Static h:ShortcutCatalog.BoldToolbarTip}" AutomationProperties.Name="{x:Static h:ShortcutCatalog.BoldToolbarTip}"/>
                                        <Button x:Name="FormatItalicButton" Style="{StaticResource FormattingToolbarButtonStyle}"
                                                Content="I" Command="{Binding ToggleItalicCommand}" FontStyle="Italic"
                                                ToolTip="{x:Static h:ShortcutCatalog.ItalicToolbarTip}" AutomationProperties.Name="{x:Static h:ShortcutCatalog.ItalicToolbarTip}"/>
                                        <Button x:Name="FormatHeadingButton" Style="{StaticResource FormattingToolbarButtonStyle}"
                                                Content="H" Command="{Binding ToggleHeadingCommand}" FontWeight="SemiBold"
                                                ToolTip="{x:Static h:ShortcutCatalog.HeadingToolbarTip}" AutomationProperties.Name="{x:Static h:ShortcutCatalog.HeadingToolbarTip}"/>
                                        <Button x:Name="FormatCodeButton" Style="{StaticResource FormattingToolbarButtonStyle}"
                                                Content="`" Command="{Binding ToggleCodeCommand}" FontFamily="Consolas"
                                                ToolTip="{x:Static h:ShortcutCatalog.CodeToolbarTip}" AutomationProperties.Name="{x:Static h:ShortcutCatalog.CodeToolbarTip}"/>
                                        <Button x:Name="FormatBulletListButton" Style="{StaticResource FormattingToolbarButtonStyle}"
                                                Content="•" Command="{Binding ToggleBulletListCommand}"
                                                ToolTip="{x:Static h:ShortcutCatalog.BulletListToolbarTip}" AutomationProperties.Name="{x:Static h:ShortcutCatalog.BulletListToolbarTip}"/>
                                        <Button x:Name="FormatNumberedListButton" Style="{StaticResource FormattingToolbarButtonStyle}"
                                                Content="1." Command="{Binding ToggleNumberedListCommand}" FontSize="11"
                                                ToolTip="{x:Static h:ShortcutCatalog.NumberedListToolbarTip}" AutomationProperties.Name="{x:Static h:ShortcutCatalog.NumberedListToolbarTip}"/>
                                        <Button x:Name="FormatCheckboxButton" Style="{StaticResource FormattingToolbarButtonStyle}"
                                                Content="☑" Command="{Binding ToggleCheckboxCommand}"
                                                ToolTip="{x:Static h:ShortcutCatalog.CheckboxToolbarTip}" AutomationProperties.Name="{x:Static h:ShortcutCatalog.CheckboxToolbarTip}"/>
                                        <Button x:Name="FormatLinkButton" Style="{StaticResource FormattingToolbarButtonStyle}"
                                                Content="🔗" Command="{Binding InsertMarkdownLinkCommand}"
                                                ToolTip="{x:Static h:ShortcutCatalog.MarkdownLinkToolbarTip}" AutomationProperties.Name="{x:Static h:ShortcutCatalog.MarkdownLinkToolbarTip}"/>
                                        <Button x:Name="FormatTableButton" Style="{StaticResource FormattingToolbarButtonStyle}"
                                                Content="⊞" Command="{Binding InsertTableCommand}"
                                                ToolTip="Вставить таблицу (3x3)" AutomationProperties.Name="Вставить таблицу (3x3)"/>
                                        <Button x:Name="FormatOutlineButton" Style="{StaticResource FormattingToolbarButtonStyle}"
                                                Content="☰" Command="{Binding ToggleOutlineCommand}"
                                                ToolTip="Оглавление заметки" AutomationProperties.Name="Оглавление заметки"/>
                                    </StackPanel>
                                </Border>

                                <!-- Pin toggle (compact icon with full tooltip) -->
                                <Button x:Name="DetailPinButton" Content="{Binding PinIcon}" Command="{Binding TogglePinCommand}"
                                        Height="28" Width="28" Padding="0" Margin="0,0,6,2" FontSize="12"
                                        Background="{DynamicResource ButtonBgBrush}" Foreground="{DynamicResource ButtonFgBrush}"
                                        FontWeight="Medium" ToolTip="{Binding PinButtonText}" AutomationProperties.Name="{Binding PinButtonText}"/>

                                <!-- Favorite toggle (compact icon with full tooltip) -->
                                <Button x:Name="DetailFavoriteButton" Content="{Binding FavoriteIcon}" Command="{Binding ToggleFavoriteCommand}"
                                        Height="28" Width="28" Padding="0" Margin="0,0,6,2" FontSize="12"
                                        Background="{DynamicResource ButtonBgBrush}" Foreground="{DynamicResource ButtonFgBrush}"
                                        FontWeight="Medium" ToolTip="{Binding FavoriteButtonText}" AutomationProperties.Name="{Binding FavoriteButtonText}"/>

                                <!-- Save button -->
                                <Button x:Name="DetailSaveButton" Content="💾 Сохранить" Command="{Binding SaveCommand}"
                                        Height="28" Padding="10,0" Margin="0,0,6,2"
                                        Background="{DynamicResource AccentBrush}" Foreground="White"
                                        FontWeight="SemiBold" ToolTip="Сохранить изменения (Ctrl+S / Ctrl+Enter)"
                                        AutomationProperties.Name="Сохранить заметку"/>

                                <!-- Detail Overflow Menu -->
                                <Button x:Name="DetailMoreButton" Content="•••" Click="DetailMoreButton_Click"
                                        Height="28" Width="28" Padding="0" Margin="0,0,0,2"
                                        Background="{DynamicResource ButtonBgBrush}" Foreground="{DynamicResource ButtonFgBrush}"
                                        FontWeight="Bold" ToolTip="Ещё действия"
                                        AutomationProperties.Name="Ещё действия детали"/>
                            </WrapPanel>
                        </Grid>

                        <!-- Source info & draft recovery banner -->
                        <StackPanel Grid.Row="1">
                            <!-- Draft recovery banner -->
                            <Border Background="{DynamicResource WarningBannerBgBrush}" BorderBrush="{DynamicResource WarningBannerBorderBrush}"
                                    BorderThickness="1" CornerRadius="8" Padding="10,6" Margin="0,0,0,8">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasUncommittedDraftRecovery}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="⚠️ Несохранённый черновик после сбоя" FontSize="12" Foreground="{DynamicResource WarningBannerFgBrush}" FontWeight="Medium" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <Button Content="Восстановить" Command="{Binding RestoreDraftCommand}"
                                                Height="22" Padding="8,0" Margin="0,0,6,0"
                                                Background="{DynamicResource ButtonBgBrush}" Foreground="{DynamicResource ButtonFgBrush}" FontSize="11" FontWeight="Medium"/>
                                        <Button Content="Удалить черновик" Command="{Binding DiscardDraftCommand}"
                                                Height="22" Padding="8,0"
                                                Background="{DynamicResource ButtonBgBrush}" Foreground="{DynamicResource ButtonFgBrush}" FontSize="11"
                                                AutomationProperties.Name="Удалить черновик"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Source context bar (if present) -->
                            <Border Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource LineBrush}"
                                    BorderThickness="1" CornerRadius="8" Padding="8,4" Margin="0,0,0,8">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasSourceText}" Value="False">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="Источник: " FontSize="11" Foreground="{DynamicResource MutedBrush}" FontWeight="Medium"/>
                                        <TextBlock Text="{Binding SourceText}" FontSize="11" Foreground="{DynamicResource InkBrush}" TextTrimming="CharacterEllipsis" ToolTip="{Binding SourceText}"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding CapturedAtText}" FontSize="10" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="8,0,0,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding CapturedAtText}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </Border>
                        </StackPanel>

                        <!-- Title field -->
                        <Border Grid.Row="2" Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource LineBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="10,6" Margin="0,0,0,8">
                            <Grid>
                                <TextBox x:Name="DetailTitleTextBox"
                                         Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"
                                         FontSize="14" FontWeight="SemiBold"
                                         BorderThickness="0" Background="Transparent"
                                         Foreground="{DynamicResource InkBrush}" CaretBrush="{DynamicResource InkBrush}"
                                         VerticalAlignment="Center"
                                         ToolTip="Заголовок заметки (необязательно)"
                                         AutomationProperties.Name="Заголовок заметки"/>
                                <TextBlock Text="Без заголовка" FontSize="14" FontWeight="SemiBold"
                                           Foreground="{DynamicResource MutedBrush}" IsHitTestVisible="False"
                                           VerticalAlignment="Center" Margin="2,0,0,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=DetailTitleTextBox}" Value="">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </Border>

                        <!-- Main Editor / Preview / Find / Locked Overlay -->
                        <Border Grid.Row="3" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}"
                                BorderThickness="1" CornerRadius="10" Padding="4">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/> <!-- Find bar -->
                                    <RowDefinition Height="*"/>    <!-- Editor / Preview / Locked -->
                                </Grid.RowDefinitions>

                                <!-- Find Bar -->
                                <Border Grid.Row="0" Background="{DynamicResource SurfaceAltBrush}"
                                        BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1"
                                        CornerRadius="8,8,0,0" Padding="6,4" Margin="0,0,0,4">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsFindOpen}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="🔍" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBox Grid.Column="1" x:Name="DetailFindInputBox"
                                                 Text="{Binding FindText, UpdateSourceTrigger=PropertyChanged}"
                                                 FontSize="12" Background="{DynamicResource SurfaceBrush}"
                                                 Foreground="{DynamicResource InkBrush}" CaretBrush="{DynamicResource InkBrush}"
                                                 BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                                                 Padding="4,2" VerticalContentAlignment="Center"
                                                 AutomationProperties.Name="Поиск в тексте заметки"/>
                                        <TextBlock Grid.Column="2" Text="{Binding MatchCountText}" FontSize="11"
                                                   Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"
                                                   Margin="6,0" MinWidth="26" TextAlignment="Center"/>
                                        <Button Grid.Column="3" Content="▲" Command="{Binding FindPreviousCommand}"
                                                Width="22" Height="22" Margin="0,0,4,0"
                                                Background="{DynamicResource ButtonBgBrush}" Foreground="{DynamicResource ButtonFgBrush}"
                                                BorderThickness="0" Cursor="Hand" ToolTip="Предыдущее (Shift+F3)"/>
                                        <Button Grid.Column="4" Content="▼" Command="{Binding FindNextCommand}"
                                                Width="22" Height="22" Margin="0,0,4,0"
                                                Background="{DynamicResource ButtonBgBrush}" Foreground="{DynamicResource ButtonFgBrush}"
                                                BorderThickness="0" Cursor="Hand" ToolTip="Следующее (F3 / Enter)"/>
                                        <Button Grid.Column="5" Content="✕" Command="{Binding CloseFindCommand}"
                                                Width="22" Height="22"
                                                Background="Transparent" Foreground="{DynamicResource MutedBrush}"
                                                BorderThickness="0" Cursor="Hand" ToolTip="Закрыть (Esc)"/>
                                    </Grid>
                                </Border>

                                <Grid Grid.Row="1" x:Name="DetailEditorPreviewGrid">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition x:Name="DetailEditorCol" Width="*"/>
                                        <ColumnDefinition x:Name="DetailEditorSplitterCol" Width="Auto"/>
                                        <ColumnDefinition x:Name="DetailPreviewCol" Width="*"/>
                                        <ColumnDefinition x:Name="DetailOutlineCol" Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition x:Name="DetailEditorRow" Height="*"/>
                                        <RowDefinition x:Name="DetailSplitterRow" Height="Auto"/>
                                        <RowDefinition x:Name="DetailPreviewRow" Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Plain text editor -->
                                    <TextBox x:Name="DetailBodyBox"
                                             Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"
                                             AcceptsReturn="True" AcceptsTab="False" TextWrapping="Wrap"
                                             VerticalScrollBarVisibility="Auto"
                                             FontSize="14" Padding="8" BorderThickness="0"
                                             Background="Transparent" Foreground="{DynamicResource InkBrush}"
                                             CaretBrush="{DynamicResource InkBrush}"
                                             AutomationProperties.Name="Текст заметки">
                                        <TextBox.Style>
                                            <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                                <Setter Property="Grid.Column" Value="0"/>
                                                <Setter Property="Grid.ColumnSpan" Value="3"/>
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSplitMode}" Value="True">
                                                        <Setter Property="Grid.ColumnSpan" Value="1"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsPreviewMode}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsLocked}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBox.Style>
                                    </TextBox>

                                    <!-- Split divider / splitter -->
                                    <GridSplitter x:Name="DetailSplitDivider" Grid.Column="1" Width="4" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                                                  Background="{DynamicResource LineBrush}" ShowsPreview="False" Cursor="SizeWE">
                                        <GridSplitter.Style>
                                            <Style TargetType="GridSplitter">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSplitMode}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsLocked}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </GridSplitter.Style>
                                    </GridSplitter>

                                    <!-- Markdown Preview -->
                                    <FlowDocumentScrollViewer x:Name="DetailPreviewViewer"
                                                              Document="{Binding PreviewDocument}"
                                                              IsToolBarVisible="False"
                                                              VerticalScrollBarVisibility="Auto"
                                                              HorizontalScrollBarVisibility="Disabled"
                                                              Background="Transparent" BorderThickness="0" Padding="8"
                                                              Foreground="{DynamicResource InkBrush}">
                                        <FlowDocumentScrollViewer.Style>
                                            <Style TargetType="FlowDocumentScrollViewer">
                                                <Setter Property="Grid.Column" Value="0"/>
                                                <Setter Property="Grid.ColumnSpan" Value="3"/>
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSplitMode}" Value="True">
                                                        <Setter Property="Grid.Column" Value="2"/>
                                                        <Setter Property="Grid.ColumnSpan" Value="1"/>
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsPreviewMode}" Value="True">
                                                        <Setter Property="Grid.Column" Value="0"/>
                                                        <Setter Property="Grid.ColumnSpan" Value="3"/>
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsLocked}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </FlowDocumentScrollViewer.Style>
                                    </FlowDocumentScrollViewer>

                                    <!-- Outline side panel -->
                                    <Border Grid.Column="3" Width="220" Margin="8,0,0,0"
                                            Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="10" Padding="8">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsOutlineOpen}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsLocked}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                            </Grid.RowDefinitions>
                                            <Grid Grid.Row="0" Margin="0,0,0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Оглавление" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource InkBrush}" VerticalAlignment="Center"/>
                                                <Button Grid.Column="1" Content="✕" Command="{Binding ToggleOutlineCommand}"
                                                        Width="20" Height="20" Background="Transparent" Foreground="{DynamicResource MutedBrush}" BorderThickness="0"
                                                        Cursor="Hand" ToolTip="Закрыть оглавление"/>
                                            </Grid>
                                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                                <ItemsControl ItemsSource="{Binding OutlineItems}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Button Command="{Binding DataContext.NavigateToOutlineItemCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                    CommandParameter="{Binding}"
                                                                    Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Left"
                                                                    Padding="3,2" Margin="0,1" Cursor="Hand">
                                                                <StackPanel Orientation="Horizontal" Margin="{Binding IndentMargin}">
                                                                    <Border Background="{DynamicResource ButtonBgBrush}" CornerRadius="3" Padding="3,1" Margin="0,0,5,0">
                                                                        <TextBlock Text="{Binding LevelBadge}" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource MutedBrush}"/>
                                                                    </Border>
                                                                    <TextBlock Text="{Binding Title}" FontSize="11" Foreground="{DynamicResource InkBrush}" TextTrimming="CharacterEllipsis"/>
                                                                </StackPanel>
                                                            </Button>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </ScrollViewer>
                                        </Grid>
                                    </Border>

                                    <!-- Locked Note Overlay -->
                                    <Border Grid.Column="0" Grid.ColumnSpan="4" Background="{DynamicResource SurfaceBrush}" CornerRadius="8" Padding="20">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsLocked}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="320">
                                            <TextBlock Text="🔒" FontSize="32" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                                            <TextBlock Text="Заметка защищена" FontWeight="SemiBold" FontSize="15"
                                                       HorizontalAlignment="Center" Margin="0,0,0,6"/>
                                            <TextBlock Text="Текст зашифрован. Введите пароль, чтобы открыть заметку."
                                                       Foreground="{DynamicResource MutedBrush}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,14"/>
                                            <Button Content="Ввести пароль" Command="{Binding UnlockNoteCommand}"
                                                    Height="32" Padding="16,0" Background="{DynamicResource AccentBrush}" Foreground="White"
                                                    FontWeight="SemiBold" HorizontalAlignment="Center" Cursor="Hand"
                                                    AutomationProperties.Name="Ввести пароль к защищённой заметке"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- Active Tags Bar -->
                        <Border Grid.Row="4" Margin="0,6,0,0">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsLocked}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel>
                            <DockPanel>
                                <TextBlock Text="Теги:" FontSize="12" Foreground="{DynamicResource MutedBrush}"
                                           VerticalAlignment="Center" Margin="0,0,8,0" DockPanel.Dock="Left"/>
                                <ItemsControl ItemsSource="{Binding ActiveTags}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource BadgeBgBrush}" BorderBrush="{DynamicResource LineBrush}"
                                                    BorderThickness="1" CornerRadius="10" Padding="8,2,4,2" Margin="0,0,4,2"
                                                    ToolTip="{Binding ChipTooltip}">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding TagName}" FontSize="11" Foreground="{DynamicResource BadgeFgBrush}"
                                                               VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                    <TextBlock Text="{Binding OriginMarker}" FontSize="10" Foreground="{DynamicResource MutedBrush}"
                                                               VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                    <Button Command="{Binding DataContext.RemoveTagCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}"
                                                            Content="×" FontSize="12" FontWeight="Bold"
                                                            Foreground="{DynamicResource MutedBrush}" Background="Transparent"
                                                            BorderThickness="0" Cursor="Hand" Width="14" Height="14" Padding="0"
                                                            ToolTip="Удалить тег"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </DockPanel>
                            <StackPanel Margin="0,6,0,0">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasSuppressedTags}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <DockPanel>
                                    <TextBlock Text="Скрытые:" FontSize="12" Foreground="{DynamicResource MutedBrush}"
                                               VerticalAlignment="Center" Margin="0,0,8,0" DockPanel.Dock="Left"/>
                                    <ItemsControl ItemsSource="{Binding SuppressedTags}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel Orientation="Horizontal"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource LineBrush}"
                                                        BorderThickness="1" CornerRadius="10" Padding="8,2,4,2" Margin="0,0,4,2"
                                                        ToolTip="{Binding ChipTooltip}">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding TagName}" FontSize="11" Foreground="{DynamicResource InkBrush}"
                                                                   VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                        <Button Command="{Binding DataContext.RestoreSuppressedTagCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                CommandParameter="{Binding}"
                                                                Content="{x:Static h:TagOriginCopy.RestoreAction}" FontSize="10"
                                                                Foreground="{DynamicResource AccentBrush}" Background="Transparent"
                                                                BorderThickness="0" Cursor="Hand" Padding="2,0"
                                                                ToolTip="{x:Static h:TagOriginCopy.RestoreAutomationName}"
                                                                AutomationProperties.Name="{x:Static h:TagOriginCopy.RestoreAutomationName}"/>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </DockPanel>
                            </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- BOARD MODE (W2 read-only adaptive board on existing cards) -->
        <Border x:Name="BoardHost" Grid.Row="1"
                Background="{DynamicResource CanvasBrush}" Visibility="Collapsed">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Hidden compatibility copy for WorkspaceShellTests (asserts distinct from vm.EmptyStateTitle/Description) -->
                <StackPanel Grid.Row="0" Visibility="Collapsed">
                    <TextBlock x:Name="BoardEmptyTitle" Text="Доска"/>
                    <TextBlock x:Name="BoardEmptyDescription" Text="Рабочая область доски заметок"/>
                </StackPanel>

                <!-- 1. EMPTY STATE FOR NOTES (when Notes.Count == 0 and not Tasks) -->
                <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="32" MaxWidth="440">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding Notes.Count}" Value="0"/>
                                        <Condition Binding="{Binding IsTasksSelected}" Value="False"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible"/>
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <Border Width="64" Height="64" CornerRadius="20" Background="{DynamicResource CardSelectedBgBrush}" HorizontalAlignment="Center" Margin="0,0,0,14">
                        <TextBlock Text="✦" FontSize="32" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock x:Name="BoardNotesEmptyTitleBlock" Text="{Binding EmptyStateTitle}" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding EmptyStateDescription}"
                               FontSize="13" Foreground="{DynamicResource MutedBrush}" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="360" Margin="0,6,0,8"/>
                    <Button Content="Сбросить фильтр" Command="{Binding ResetFilterCommand}"
                            Height="32" Padding="14,0" HorizontalAlignment="Center"
                            Background="{DynamicResource ButtonBgBrush}" Foreground="{DynamicResource ButtonFgBrush}" FontWeight="Medium" BorderThickness="0" Cursor="Hand"
                            AutomationProperties.Name="Сбросить фильтр на доске">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ShowEmptyStateResetFilter}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>

                <!-- 2. EMPTY STATE FOR TASKS (when Tasks.Count == 0 and IsTasksSelected == True) -->
                <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="32" MaxWidth="440">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding Tasks.Count}" Value="0"/>
                                        <Condition Binding="{Binding IsTasksSelected}" Value="True"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible"/>
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <Border Width="64" Height="64" CornerRadius="20" Background="{DynamicResource CardSelectedBgBrush}" HorizontalAlignment="Center" Margin="0,0,0,14">
                        <TextBlock Text="☐" FontSize="32" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock x:Name="BoardTasksEmptyTitleBlock" Text="{Binding EmptyStateTitle}" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding EmptyStateDescription}"
                               FontSize="13" Foreground="{DynamicResource MutedBrush}" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="360" Margin="0,6,0,8"/>
                    <Button Content="Сбросить фильтр" Command="{Binding ResetFilterCommand}"
                            Height="32" Padding="14,0" HorizontalAlignment="Center"
                            Background="{DynamicResource ButtonBgBrush}" Foreground="{DynamicResource ButtonFgBrush}" FontWeight="Medium" BorderThickness="0" Cursor="Hand"
                            AutomationProperties.Name="Сбросить фильтр задач на доске">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ShowEmptyStateResetFilter}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>

                <!-- 3. SCROLLABLE BOARD (Notes) -->
                <ScrollViewer x:Name="BoardScrollViewer" Grid.Row="1"
                              VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ScrollViewer.Style>
                        <Style TargetType="ScrollViewer">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Notes.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsTasksSelected}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ScrollViewer.Style>
                    <StackPanel Margin="12,12,0,24">
                        <ListBox x:Name="BoardListBox"
                                 ItemsSource="{Binding Notes}"
                                 SelectedItem="{Binding SelectedNote, Mode=TwoWay}"
                                 ItemTemplate="{StaticResource NoteCardItemTemplate}"
                                 Background="Transparent" BorderThickness="0" Padding="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                 AutomationProperties.Name="Доска заметок">
                            <ListBox.Template>
                                <ControlTemplate TargetType="ListBox">
                                    <ItemsPresenter/>
                                </ControlTemplate>
                            </ListBox.Template>
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="0,0,12,12"/>
                                    <Setter Property="Width" Value="{Binding BoardCardWidth, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <ContentPresenter/>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                        </ListBox>

                        <!-- Load More Notes Button -->
                        <Button x:Name="BoardLoadMoreNotesButton"
                                Content="{Binding LoadMoreButtonText}"
                                Command="{Binding LoadMoreNotesCommand}"
                                Height="30" Padding="18,0" Margin="0,8,12,0" HorizontalAlignment="Center"
                                Background="{DynamicResource ButtonBgBrush}"
                                Foreground="{DynamicResource ButtonFgBrush}"
                                BorderThickness="1"
                                BorderBrush="{DynamicResource LineBrush}"
                                FontWeight="SemiBold"
                                Cursor="Hand"
                                ToolTip="Загрузить следующие заметки"
                                AutomationProperties.Name="Загрузить ещё заметки на доске">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasMoreNotes}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </ScrollViewer>

                <!-- 4. TASKS LIST (when IsTasksSelected == True) -->
                <ListBox x:Name="BoardTasksListBox" Grid.Row="1"
                         ItemsSource="{Binding Tasks}"
                         SelectedItem="{Binding SelectedTask, Mode=TwoWay}"
                         Background="Transparent" BorderThickness="0" Padding="14,10"
                         TabIndex="3"
                         AutomationProperties.Name="Список открытых задач на доске"
                         ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.CanContentScroll="True" VirtualizingPanel.ScrollUnit="Pixel"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling"
                         ItemTemplate="{StaticResource TaskItemTemplate}">
                    <ListBox.Style>
                        <Style TargetType="ListBox">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsTasksSelected}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Tasks.Count}" Value="0">
                                    <Setter Property="IsHitTestVisible" Value="False"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ListBox.Style>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="AutomationProperties.Name" Value="{Binding AccessibilityName}"/>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </Grid>
        </Border>

        <!-- STATUS BAR -->
        <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="12,4">
            <Grid x:Name="StatusBarGrid">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/> <!-- Left: Status & Sync -->
                    <ColumnDefinition Width="*"/>    <!-- Center/Right: Hints -->
                </Grid.ColumnDefinitions>

                <!-- Left: Essential Status (Note count, active section, sync) -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="StatusTextBlock" Text="{Binding StatusText}" FontSize="11" Foreground="{DynamicResource MutedBrush}"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding StatusText}" MaxWidth="420"/>
                    <ProgressBar IsIndeterminate="True" Width="60" Height="10" Margin="8,0,0,0" VerticalAlignment="Center">
                        <ProgressBar.Style>
                            <Style TargetType="ProgressBar">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsScreenOcrInProgress}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsSyncBusy}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ProgressBar.Style>
                    </ProgressBar>

                    <!-- Compact Sync Status in Status Bar: accessible keyboard-invokable action (UX/a11y) -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                        <Button x:Name="PublicationStatusBarButton"
                                Command="{Binding SyncStatusActionCommand}"
                                ToolTip="{Binding SyncStatusTooltip}"
                                AutomationProperties.Name="{Binding SyncStatusActionAutomationName}"
                                AutomationProperties.HelpText="{Binding SyncStatusTooltip}"
                                FontSize="11" FontWeight="Medium" MinHeight="22" Padding="6,1"
                                Background="Transparent" BorderBrush="Transparent" BorderThickness="1"
                                VerticalAlignment="Center">
                            <TextBlock x:Name="PublicationStatusBarText"
                                       Text="{Binding SyncStatusSummaryText}"
                                       FontSize="11" FontWeight="Medium" VerticalAlignment="Center"
                                       IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SyncStatusActionTone}" Value="Warning">
                                                <Setter Property="Foreground" Value="{DynamicResource WarningBannerFgBrush}"/>
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding SyncStatusActionTone}" Value="Error">
                                                <Setter Property="Foreground" Value="{DynamicResource ErrorBannerFgBrush}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding SyncStatusActionTone}" Value="Success">
                                                <Setter Property="Foreground" Value="{DynamicResource SuccessBannerFgBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Button>
                        <TextBlock Text="{Binding CloudUsageStatusBarText}" Margin="6,0,0,0" FontSize="11"
                                   Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"
                                   ToolTip="{Binding CloudUsageExplanationText}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CloudUsageStatusBarText}" Value="">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </StackPanel>

                <!-- Right: Navigation hints, OCR, Hotkeys -->
                <DockPanel Grid.Column="1" HorizontalAlignment="Right" LastChildFill="True" Margin="16,0,0,0">
                    <!-- Navigation hint: Only in wide layout -->
                    <TextBlock x:Name="NavHintsBlock" DockPanel.Dock="Left" Margin="0,0,12,0"
                               FontSize="11" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="F6: панели | Alt+↓/↑: выбор | Enter: открыть"/>
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsNarrow}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding WorkspaceViewMode}" Value="Board">
                                        <Setter Property="Text" Value="F6: панели | Alt+↓/↑: выбор | Ctrl+E: изменить"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding WorkspaceViewMode}" Value="Focus">
                                        <Setter Property="Text" Value="Esc: выйти из фокуса | Ctrl+E: редактор"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!-- OCR gesture hint -->
                    <TextBlock x:Name="OcrGestureBlock" DockPanel.Dock="Left" Margin="0,0,12,0"
                               Text="{Binding OcrStatusBarGestureText}"
                               FontSize="11" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>

                    <!-- Hotkey hint: trims with ellipsis if constrained, full tooltip -->
                    <TextBlock x:Name="HotkeyHint" Text="{Binding HotkeyHint}"
                               FontSize="11" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" ToolTip="{Binding HotkeyHint}"/>
                </DockPanel>
            </Grid>
        </Border>
    </Grid>
</Window>

