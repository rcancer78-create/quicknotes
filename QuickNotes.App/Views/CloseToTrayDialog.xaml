<Window x:Class="QuickNotes.App.Views.CloseToTrayDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="QuickNotes продолжит работать"
        Width="520" Height="280"
        MinWidth="480" MinHeight="240"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource CanvasBrush}"
        AutomationProperties.Name="Диалог закрытия в системный трей">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <TextBlock x:Name="PromptText"
                       TextWrapping="Wrap"
                       FontSize="13"
                       Foreground="{DynamicResource InkBrush}"
                       AutomationProperties.Name="Пояснение о работе в трее"/>
        </ScrollViewer>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="CancelButton" Content="Вернуться" Width="110" Height="32" Margin="0,0,8,0"
                    IsCancel="True" Click="OnCancel"
                    Background="{DynamicResource ButtonBgBrush}" Foreground="{DynamicResource ButtonFgBrush}"
                    ToolTip="Оставить окно открытым"
                    AutomationProperties.Name="Вернуться к окну"/>
            <Button x:Name="ExitButton" Content="Выйти" Width="110" Height="32" Margin="0,0,8,0"
                    Click="OnExit"
                    Background="{DynamicResource ButtonBgBrush}" Foreground="{DynamicResource ButtonFgBrush}"
                    ToolTip="Полностью завершить QuickNotes"
                    AutomationProperties.Name="Выйти из программы"/>
            <Button x:Name="HideButton" Content="Скрыть" Width="120" Height="32"
                    IsDefault="True" Click="OnHide"
                    Background="{DynamicResource AccentBrush}" Foreground="White" FontWeight="SemiBold"
                    ToolTip="Скрыть окно и оставить программу в системном трее"
                    AutomationProperties.Name="Скрыть в системный трей"/>
        </StackPanel>
    </Grid>
</Window>
