<Window x:Class="QuickNotes.App.Views.TagRescanPreviewDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title}"
        Height="540" Width="560"
        MinHeight="420" MinWidth="480"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource CanvasBrush}">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- 0. Warning Banner -->
            <RowDefinition Height="Auto"/> <!-- 1. Summary Cards -->
            <RowDefinition Height="Auto"/> <!-- 2. Section Header -->
            <RowDefinition Height="*"/>    <!-- 3. Notes List / No Changes -->
            <RowDefinition Height="Auto"/> <!-- 4. Status Message -->
            <RowDefinition Height="Auto"/> <!-- 5. Action Buttons -->
        </Grid.RowDefinitions>

        <!-- 0. WARNING BANNER -->
        <Border Grid.Row="0" Background="{DynamicResource WarningBannerBgBrush}" BorderBrush="{DynamicResource WarningBannerBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="⚠️" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Top"/>
                <TextBlock Grid.Column="1" Text="{Binding WarningMessage}" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource WarningBannerFgBrush}" FontWeight="Medium"/>
            </Grid>
        </Border>

        <!-- 1. SUMMARY / TOTALS CARDS -->
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Card 1: Scanned -->
            <Border Grid.Column="0" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="6" Padding="8,6" Margin="0,0,4,0">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="Проверено" FontSize="11" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding TotalNotesScannedText}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource InkBrush}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                </StackPanel>
            </Border>

            <!-- Card 2: Notes with changes -->
            <Border Grid.Column="1" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="6" Padding="8,6" Margin="4,0,4,0">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="С изменениями" FontSize="11" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding TotalNotesWithChangesText}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                </StackPanel>
            </Border>

            <!-- Card 3: Added -->
            <Border Grid.Column="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="6" Padding="8,6" Margin="4,0,4,0">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="Будет добавлено" FontSize="11" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding TotalAddedTagsText}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource SuccessBannerFgBrush}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                </StackPanel>
            </Border>

            <!-- Card 4: Removed -->
            <Border Grid.Column="3" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="6" Padding="8,6" Margin="4,0,0,0">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="Будет удалено" FontSize="11" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding TotalRemovedTagsText}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource ErrorBannerFgBrush}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- 2. SECTION HEADER -->
        <TextBlock Grid.Row="2" Text="Заметки с изменениями:" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,6"/>

        <!-- 3. NOTES LIST / NO CHANGES PLACEHOLDER -->
        <Border Grid.Row="3" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="6" Padding="6" Margin="0,0,0,8">
            <Grid>
                <!-- When changes exist: Show List -->
                <ListBox ItemsSource="{Binding ChangedNotes}"
                         Visibility="{Binding HasChangesVisibility}"
                         BorderThickness="0" Background="Transparent"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="6" Padding="10,7" Margin="0,0,0,5">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Row 0: Note ID and Title -->
                                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,3">
                                        <TextBlock Text="{Binding NoteId, StringFormat='#{0}'}" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="0,0,8,0" FontSize="12"/>
                                        <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" FontSize="12" Foreground="{DynamicResource InkBrush}" FontWeight="SemiBold"/>
                                    </StackPanel>

                                    <!-- Row 1: Added and Removed tags -->
                                    <StackPanel Grid.Row="1" Orientation="Vertical">
                                        <StackPanel Orientation="Horizontal" Visibility="{Binding AddedTagsVisibility}" Margin="0,1">
                                            <TextBlock Text="+ " FontWeight="Bold" Foreground="{DynamicResource SuccessBannerFgBrush}" FontSize="12"/>
                                            <TextBlock Text="{Binding AddedTagsDisplay}" Foreground="{DynamicResource SuccessBannerFgBrush}" FontSize="12" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Visibility="{Binding RemovedTagsVisibility}" Margin="0,1">
                                            <TextBlock Text="- " FontWeight="Bold" Foreground="{DynamicResource ErrorBannerFgBrush}" FontSize="12"/>
                                            <TextBlock Text="{Binding RemovedTagsDisplay}" Foreground="{DynamicResource ErrorBannerFgBrush}" FontSize="12" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- When NO changes exist: Friendly message -->
                <Border Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="6" Padding="20"
                        Visibility="{Binding NoChangesVisibility}" HorizontalAlignment="Stretch" VerticalAlignment="Center" Margin="10">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="✓ Изменений нет" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource SuccessBannerFgBrush}" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                        <TextBlock Text="Все автоматические теги уже соответствуют текущему тексту заметок." FontSize="12" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- 4. STATUS MESSAGE -->
        <TextBlock Grid.Row="4" Text="{Binding StatusMessage}" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,10"/>

        <!-- 5. ACTION BUTTONS -->
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="{Binding CancelButtonText}" Command="{Binding CancelCommand}" IsCancel="True"
                    Width="90" Height="32" Margin="0,0,8,0"
                    ToolTip="Отменить сканирование"
                    Background="{DynamicResource ButtonBgBrush}" Foreground="{DynamicResource ButtonFgBrush}" BorderThickness="0" Cursor="Hand"/>
            <Button Content="Применить" Command="{Binding ConfirmCommand}" IsEnabled="{Binding CanConfirm}" IsDefault="True"
                    Visibility="{Binding ConfirmButtonVisibility}"
                    Width="120" Height="32"
                    ToolTip="Применить изменения тегов"
                    Background="{DynamicResource AccentBrush}" Foreground="White" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand"/>
        </StackPanel>
    </Grid>
</Window>
