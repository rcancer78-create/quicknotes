<Window x:Class="QuickNotes.App.Views.FirstRunWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Добро пожаловать в QuickNotes"
        Width="560" Height="480"
        MinWidth="420" MinHeight="360"
        MaxWidth="720" MaxHeight="720"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="{DynamicResource CanvasBrush}"
        AutomationProperties.Name="Окно первого запуска">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Быстрый старт" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}"/>
            <TextBlock Text="Два сочетания, входящие и данные на этом компьютере."
                       FontSize="13" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,6,0,0"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" Margin="0,16,0,16" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="Две горячие клавиши" FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource InkBrush}"/>
                        <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource InkBrush}" Margin="0,6,0,0"
                                   Text="{Binding HotkeySummary}"/>
                    </StackPanel>
                </Border>

                <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="Раздел «Входящие»" FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource InkBrush}"/>
                        <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource InkBrush}" Margin="0,6,0,0"
                                   Text="Мгновенное сохранение кладёт заметку во «Входящие». Разберите её и нажмите «Обработано и следующая» (Ctrl+Enter)."/>
                    </StackPanel>
                </Border>

                <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="Где лежат данные" FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource InkBrush}"/>
                        <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource InkBrush}" Margin="0,6,0,0"
                                   Text="{Binding DataLocationText}"/>
                        <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0,6,0,0"
                                   Text="Облако выключено, пока вы сами его не подключите. Крестик главного окна скрывает программу в трей — горячие клавиши продолжают работать, пока вы явно не выйдете."/>
                    </StackPanel>
                </Border>

                <CheckBox x:Name="StarterTagsCheck" Content="Создать стартовые теги: Работа, Личное, Идеи"
                          IsChecked="False" FontSize="13" Foreground="{DynamicResource InkBrush}"
                          ToolTip="Теги не создаются сами. Отметьте, только если они вам нужны."/>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Открыть справку" Click="Help_Click" Height="34" Padding="14,0" Margin="0,0,8,0"
                    Background="{DynamicResource ButtonBgBrush}" Foreground="{DynamicResource ButtonFgBrush}"/>
            <Button Content="Начать работу" IsDefault="True" Click="Start_Click" Height="34" Padding="16,0"
                    Background="{DynamicResource AccentBrush}" Foreground="White" FontWeight="SemiBold"
                    AutomationProperties.Name="Начать работу"/>
        </StackPanel>
    </Grid>
</Window>
