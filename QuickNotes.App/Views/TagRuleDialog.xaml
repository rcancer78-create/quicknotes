<Window x:Class="QuickNotes.App.Views.TagRuleDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title}"
        Height="540" Width="720"
        MinHeight="440" MinWidth="600"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource CanvasBrush}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0" Text="{Binding Title}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource InkBrush}" Margin="0,0,0,8"/>

        <!-- Explanation Banner -->
        <Border Grid.Row="1" Background="{DynamicResource InfoBannerBgBrush}" BorderBrush="{DynamicResource InfoBannerBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="Логика работы правил автотега:" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource InfoBannerFgBrush}" Margin="0,0,0,4"/>
                <TextBlock Text="Тег назначается при базовом совпадении имени или синонима, только если выполнены все заданные условия:"
                           FontSize="11" Foreground="{DynamicResource InfoBannerFgBrush}" Margin="0,0,0,2"/>
                <TextBlock Text="• Обязательные (все): все указанные термины должны присутствовать в заметке."
                           FontSize="11" Foreground="{DynamicResource InfoBannerFgBrush}"/>
                <TextBlock Text="• Любые (хотя бы одно): хотя бы один из терминов должен присутствовать (если список пуст — условие не проверяется)."
                           FontSize="11" Foreground="{DynamicResource InfoBannerFgBrush}"/>
                <TextBlock Text="• Исключения (ни одного): ни один из указанных терминов не должен присутствовать в заметке."
                           FontSize="11" Foreground="{DynamicResource InfoBannerFgBrush}"/>
            </StackPanel>
        </Border>

        <!-- 3 Columns for Conditions -->
        <Grid Grid.Row="2" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 1. REQUIRED (ALL) TERMS -->
            <Border Grid.Column="0" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="6" Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="📌 Обязательные (все)" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource InfoBannerFgBrush}" Margin="0,0,0,6"/>

                    <Grid Grid.Row="1" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Text="{Binding NewRequiredTerm, UpdateSourceTrigger=PropertyChanged}"
                                 Height="28" VerticalContentAlignment="Center" Padding="6,0" FontSize="12"
                                 BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1" x:Name="RequiredTextBox"
                                 ToolTip="Ввести термин, который обязательно должен быть в заметке"/>
                        <Button Grid.Column="1" Content="+" Command="{Binding AddRequiredTermCommand}"
                                Width="28" Height="28" Margin="4,0,0,0"
                                Background="{DynamicResource AccentBrush}" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand"
                                ToolTip="Добавить обязательный термин"/>
                    </Grid>

                    <Border Grid.Row="2" Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="4">
                        <ListBox ItemsSource="{Binding RequiredTerms}" BorderThickness="0" Background="Transparent">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="2,1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding}" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource InkBrush}" TextTrimming="CharacterEllipsis"/>
                                        <Button Grid.Column="1" Content="×"
                                                Command="{Binding DataContext.DeleteRequiredTermCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                CommandParameter="{Binding}"
                                                Width="20" Height="20" FontSize="12" FontWeight="Bold"
                                                Background="Transparent" Foreground="{DynamicResource ErrorBannerFgBrush}" BorderThickness="0" Cursor="Hand"
                                                ToolTip="Удалить термин"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                </Grid>
            </Border>

            <!-- 2. ANY TERMS -->
            <Border Grid.Column="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="6" Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="🔀 Любые (хотя бы одно)" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,6"/>

                    <Grid Grid.Row="1" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Text="{Binding NewAnyTerm, UpdateSourceTrigger=PropertyChanged}"
                                 Height="28" VerticalContentAlignment="Center" Padding="6,0" FontSize="12"
                                 BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1" x:Name="AnyTextBox"
                                 ToolTip="Ввести термин, из которых хотя бы один должен присутствовать"/>
                        <Button Grid.Column="1" Content="+" Command="{Binding AddAnyTermCommand}"
                                Width="28" Height="28" Margin="4,0,0,0"
                                Background="{DynamicResource AccentBrush}" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand"
                                ToolTip="Добавить термин выбора"/>
                    </Grid>

                    <Border Grid.Row="2" Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="4">
                        <ListBox ItemsSource="{Binding AnyTerms}" BorderThickness="0" Background="Transparent">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="2,1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding}" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource InkBrush}" TextTrimming="CharacterEllipsis"/>
                                        <Button Grid.Column="1" Content="×"
                                                Command="{Binding DataContext.DeleteAnyTermCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                CommandParameter="{Binding}"
                                                Width="20" Height="20" FontSize="12" FontWeight="Bold"
                                                Background="Transparent" Foreground="{DynamicResource ErrorBannerFgBrush}" BorderThickness="0" Cursor="Hand"
                                                ToolTip="Удалить термин"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                </Grid>
            </Border>

            <!-- 3. EXCLUDED TERMS -->
            <Border Grid.Column="4" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="6" Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="🚫 Исключения (ни одного)" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource ErrorBannerFgBrush}" Margin="0,0,0,6"/>

                    <Grid Grid.Row="1" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Text="{Binding NewExcludedTerm, UpdateSourceTrigger=PropertyChanged}"
                                 Height="28" VerticalContentAlignment="Center" Padding="6,0" FontSize="12"
                                 BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1" x:Name="ExcludedTextBox"
                                 ToolTip="Ввести термин-исключение, которого не должно быть в заметке"/>
                        <Button Grid.Column="1" Content="+" Command="{Binding AddExcludedTermCommand}"
                                Width="28" Height="28" Margin="4,0,0,0"
                                Background="#DC2626" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand"
                                ToolTip="Добавить исключающий термин"/>
                    </Grid>

                    <Border Grid.Row="2" Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="4">
                        <ListBox ItemsSource="{Binding ExcludedTerms}" BorderThickness="0" Background="Transparent">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="2,1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding}" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource InkBrush}" TextTrimming="CharacterEllipsis"/>
                                        <Button Grid.Column="1" Content="×"
                                                Command="{Binding DataContext.DeleteExcludedTermCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                CommandParameter="{Binding}"
                                                Width="20" Height="20" FontSize="12" FontWeight="Bold"
                                                Background="Transparent" Foreground="{DynamicResource ErrorBannerFgBrush}" BorderThickness="0" Cursor="Hand"
                                                ToolTip="Удалить термин"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- Bottom Actions -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Отмена" Command="{Binding CancelCommand}" IsCancel="True"
                    Width="100" Height="34" Margin="0,0,8,0"
                    Background="{DynamicResource ButtonBgBrush}" Foreground="{DynamicResource ButtonFgBrush}" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand"
                    ToolTip="Отменить изменения и закрыть окно (Esc)"/>
            <Button Content="Сохранить" Command="{Binding SaveCommand}" IsDefault="True"
                    Width="110" Height="34"
                    Background="{DynamicResource AccentBrush}" Foreground="White" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand"
                    ToolTip="Сохранить правила автотега (Ctrl+Enter / Enter)"/>
        </StackPanel>
    </Grid>
</Window>
