<Window x:Class="QuickNotes.App.Views.ImportExportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:h="clr-namespace:QuickNotes.App.Helpers"
        Title="{x:Static h:UserTaskCopy.TransferWindowTitle}"
        Height="720" Width="780"
        MinHeight="520" MinWidth="640"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource CanvasBrush}">

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TabControl Grid.Row="0" SelectedIndex="{Binding SelectedTabIndex}" Background="Transparent" BorderThickness="0">
            <!-- TAB 1: ЭКСПОРТ -->
            <TabItem Header="{x:Static h:UserTaskCopy.ExportTab}" FontSize="13" FontWeight="SemiBold" Padding="12,6" ToolTip="Сохранить незащищённые заметки в локальные файлы">
                <Grid Margin="0,16,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Description -->
                        <RowDefinition Height="Auto"/> <!-- Available Count -->
                        <RowDefinition Height="*"/>    <!-- Export Cards -->
                        <RowDefinition Height="Auto"/> <!-- Status -->
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="{x:Static h:UserTaskCopy.ExportLead}"
                               FontSize="13" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,8"/>

                    <Border Grid.Row="1" Background="{DynamicResource InfoBannerBgBrush}" BorderBrush="{DynamicResource InfoBannerBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,0,16">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Доступно активных заметок для экспорта: " FontSize="12" Foreground="{DynamicResource InfoBannerFgBrush}" FontWeight="Medium"/>
                                <TextBlock Text="{Binding NonDeletedNotesCount, Mode=OneWay}" FontSize="12" Foreground="{DynamicResource InkBrush}" FontWeight="Bold"/>
                            </StackPanel>
                            <TextBlock Text="{Binding LastSuccessfulExportBanner, Mode=OneWay}" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource InfoBannerFgBrush}" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>

                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <StackPanel Orientation="Vertical">
                            <!-- Card 1: Markdown -->
                            <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                        <TextBlock Text="Открытый snapshot (.md + вложения + manifest.json)" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource InkBrush}"/>
                                        <TextBlock Text="Вы выбираете каталог. Записываются только незащищённые заметки: первая строка как заголовок, теги, ссылки, источник и доступные файлы-вложения. Есть предупреждение о plaintext, staging и атомарная замена snapshot. Это не полный архив и не восстановление базы."
                                                   TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="Экспорт в Markdown..." Command="{Binding ExportMarkdownCommand}"
                                            Height="34" Padding="14,0" VerticalAlignment="Center"
                                            Background="{DynamicResource AccentBrush}" Foreground="White" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand"
                                            ToolTip="Выбрать каталог и экспортировать открытый snapshot"/>
                                </Grid>
                            </Border>

                            <!-- Card 2: JSON -->
                            <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                        <TextBlock Text="QuickNotes JSON (.json)" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource InkBrush}"/>
                                        <TextBlock Text="Текстовый JSON со служебными полями, тегами и синонимами. Без бинарных вложений и без секретов. Это не полный архив."
                                                   TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="Экспорт в JSON..." Command="{Binding ExportJsonCommand}"
                                            Height="34" Padding="14,0" VerticalAlignment="Center"
                                            Background="{DynamicResource AccentBrush}" Foreground="White" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand"
                                            ToolTip="Экспортировать архив заметок в JSON-файл"/>
                                </Grid>
                            </Border>

                            <!-- Card 3: CSV -->
                            <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                        <TextBlock Text="CSV-таблица (.csv)" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource InkBrush}"/>
                                        <TextBlock Text="Текстовая таблица UTF-8 с BOM (ID, текст, даты, флаги, теги, источник). Без вложений. Это не полный архив."
                                                   TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="Экспорт в CSV..." Command="{Binding ExportCsvCommand}"
                                            Height="34" Padding="14,0" VerticalAlignment="Center"
                                            Background="{DynamicResource AccentBrush}" Foreground="White" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand"
                                            ToolTip="Экспортировать заметки в CSV-таблицу"/>
                                </Grid>
                            </Border>

                            <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                        <TextBlock Text="Полный архив с вложениями (.qnarchive.zip)" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource InkBrush}"/>
                                        <TextBlock Text="Переносимый ZIP с текстом, тегами и исходными файлами. Проверяются SHA-256, пути защищены, импорт атомарный и не перезаписывает существующие заметки."
                                                   TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="Экспорт архива..." Command="{Binding ExportArchiveCommand}"
                                            Height="34" Padding="14,0" VerticalAlignment="Center"
                                            Background="{DynamicResource AccentBrush}" Foreground="White" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand"
                                            ToolTip="Экспортировать полный архив с вложениями"/>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Export Status -->
                    <TextBlock Grid.Row="3" Text="{Binding ExportStatusMessage}" TextWrapping="Wrap"
                               FontSize="12" FontWeight="Medium" Foreground="{DynamicResource InfoBannerFgBrush}" Margin="0,10,0,0"/>
                </Grid>
            </TabItem>

            <!-- TAB 2: ИМПОРТ -->
            <TabItem Header="{x:Static h:UserTaskCopy.ImportTab}" FontSize="13" FontWeight="SemiBold" Padding="12,6" ToolTip="Загрузить заметки из файлов или папки">
                <ScrollViewer x:Name="ImportPreviewScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              AutomationProperties.Name="Прокрутка предпросмотра импорта"
                              AutomationProperties.AutomationId="ImportPreviewScrollViewer">
                <Grid Margin="0,14,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                        <Button Content="Выбрать файл(ы)..." Command="{Binding SelectFilesCommand}"
                                Height="32" Padding="14,0" Margin="0,0,8,0"
                                AutomationProperties.Name="Выбрать файлы для импорта"
                                AutomationProperties.AutomationId="ImportSelectFilesButton"
                                Background="{DynamicResource ButtonBgBrush}" Foreground="{DynamicResource ButtonFgBrush}" FontWeight="Medium" BorderThickness="0" Cursor="Hand"
                                ToolTip="Импортировать отдельные файлы (.md, .txt, .html, .json)"/>

                        <Button Content="Выбрать папку..." Command="{Binding SelectFolderCommand}"
                                Height="32" Padding="14,0"
                                AutomationProperties.Name="Выбрать папку для импорта"
                                AutomationProperties.AutomationId="ImportSelectFolderButton"
                                Background="{DynamicResource ButtonBgBrush}" Foreground="{DynamicResource ButtonFgBrush}" FontWeight="Medium" BorderThickness="0" Cursor="Hand"
                                ToolTip="Импортировать Markdown и HTML из дерева папок: корень → тег, раздел → дочерний тег"/>
                    </StackPanel>

                    <!-- 2. Conflict Policy Banner -->
                    <Border Grid.Row="1" Background="{DynamicResource WarningBannerBgBrush}" BorderBrush="{DynamicResource WarningBannerBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,10"
                            AutomationProperties.Name="Политика конфликтов импорта">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="ℹ" FontSize="14" FontWeight="Bold" Margin="0,0,8,0" VerticalAlignment="Top" Foreground="{DynamicResource WarningBannerFgBrush}"/>
                            <TextBlock Grid.Column="1" Text="{Binding ConflictPolicyDescription, Mode=OneWay}" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource WarningBannerFgBrush}" FontWeight="Medium"/>
                        </Grid>
                    </Border>

                    <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,0,0,10"
                            AutomationProperties.Name="Панель сопоставления папок"
                            AutomationProperties.AutomationId="ImportFolderMappingPanel">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasFolderMapping}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ShowImportPreviewChrome}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <TextBlock Text="Сопоставление папок: блокнот → корневой тег, раздел → дочерний тег (можно изменить до commit)"
                                       FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}" Margin="0,0,0,6"
                                       TextWrapping="Wrap"
                                       AutomationProperties.Name="Сопоставление папок импорта"/>
                            <ItemsControl ItemsSource="{Binding FolderMappings}" AutomationProperties.Name="Список сопоставления папок и тегов">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="140"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                                <TextBlock Text="{Binding RelativeFolder}" FontSize="11" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"
                                                           ToolTip="{Binding RelativeFolder}"/>
                                                <TextBlock Text="{Binding Role}" FontSize="11" Foreground="{DynamicResource WarningBannerFgBrush}" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <TextBox Grid.Column="1" Text="{Binding ProposedTagName, UpdateSourceTrigger=LostFocus}"
                                                     MinHeight="24" Padding="4,0" VerticalContentAlignment="Center" FontSize="11"
                                                     LostFocus="MappingTag_LostFocus"
                                                     AutomationProperties.Name="{Binding ProposedTagName, StringFormat='Тег для папки {0}'}"
                                                     IsReadOnly="{Binding IsAmbiguous}"
                                                     ToolTip="Имя тега. Неоднозначная вложенность не назначается автоматически."/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- 3. Summary / Totals Cards -->
                    <Grid Grid.Row="3" Margin="0,0,0,10">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasPreview}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ShowImportPreviewChrome}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Discovered -->
                        <Border Grid.Column="0" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="6" Padding="8,6" Margin="0,0,3,0">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="Файлов" FontSize="11" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding TotalFilesDiscovered, Mode=OneWay}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource InkBrush}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- To Import -->
                        <Border Grid.Column="1" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="6" Padding="8,6" Margin="3,0,3,0">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="К импорту" FontSize="11" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding TotalNotesToImport, Mode=OneWay}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource SuccessBannerFgBrush}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Conflicts (Skipped) -->
                        <Border Grid.Column="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="6" Padding="8,6" Margin="3,0,3,0">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="Конфликтов" FontSize="11" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding TotalConflicts, Mode=OneWay}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource WarningBannerFgBrush}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- New tags -->
                        <Border Grid.Column="3" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="6" Padding="8,6" Margin="3,0,3,0">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="Новых тегов" FontSize="11" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding NewTagsCount, Mode=OneWay}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Skipped / Erroneous -->
                        <Border Grid.Column="4" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="6" Padding="8,6" Margin="3,0,0,0">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="Ошибок" FontSize="11" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding TotalSkippedOrErroneous, Mode=OneWay}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource ErrorBannerFgBrush}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <ItemsControl Grid.Row="4" Margin="0,0,0,10" ItemsSource="{Binding PreviewItems}"
                                  AutomationProperties.Name="Разрешение конфликтов импорта"
                                  AutomationProperties.AutomationId="ImportConflictResolutionList">
                        <ItemsControl.Style>
                            <Style TargetType="ItemsControl">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding TotalConflicts}" Value="0">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ShowImportPreviewChrome}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ItemsControl.Style>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,6">
                                    <Grid.Style>
                                        <Style TargetType="Grid">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsConflict}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Grid.Style>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding DisplayTitle}" FontSize="12" FontWeight="SemiBold"
                                               Foreground="{DynamicResource InkBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                               Margin="0,0,8,0"/>
                                    <ComboBox Grid.Column="1" MinWidth="200" MinHeight="28"
                                              Background="{DynamicResource InputBgBrush}"
                                              Foreground="{DynamicResource InputFgBrush}"
                                              BorderBrush="{DynamicResource InputBorderBrush}"
                                              ItemsSource="{Binding DataContext.DuplicateChoices, RelativeSource={RelativeSource AncestorType=Window}}"
                                              SelectedValue="{Binding DuplicateAction, Mode=TwoWay}"
                                              SelectedValuePath="Action"
                                              DisplayMemberPath="Label"
                                              SelectionChanged="DuplicateAction_SelectionChanged"
                                              AutomationProperties.Name="{Binding DisplayTitle, StringFormat='Разрешение дубликата: {0}'}"
                                              AutomationProperties.AutomationId="ImportDuplicateActionCombo"
                                              ToolTip="Пропустить, импортировать отдельно или заменить только тот же источник"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Preview List / Diagnostics -->
                    <Border Grid.Row="5" MinHeight="220" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource SuccessBannerBorderBrush}" BorderThickness="2" CornerRadius="6" Padding="12" Margin="0,0,0,10"
                            AutomationProperties.Name="Итог успешного импорта"
                            AutomationProperties.AutomationId="ImportSuccessSummaryPanel">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasCompletedImport}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <TextBlock Text="Импорт завершён" FontSize="16" FontWeight="Bold"
                                       Foreground="{DynamicResource SuccessBannerFgBrush}" Margin="0,0,0,8"/>
                            <TextBlock Text="{Binding LastImportSummary}" TextWrapping="Wrap" FontSize="13"
                                       Foreground="{DynamicResource InkBrush}" Margin="0,0,0,10"
                                       AutomationProperties.Name="Сводка импорта"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="{DynamicResource SuccessBannerBgBrush}" BorderBrush="{DynamicResource SuccessBannerBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="8,10" Margin="0,0,4,0">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="Импортировано" FontSize="11" Foreground="{DynamicResource SuccessBannerFgBrush}" HorizontalAlignment="Center"/>
                                        <TextBlock Text="{Binding LastImportedNotesCount}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource SuccessBannerFgBrush}" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="1" Background="{DynamicResource WarningBannerBgBrush}" BorderBrush="{DynamicResource WarningBannerBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="8,10" Margin="4,0">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="Заменено" FontSize="11" Foreground="{DynamicResource WarningBannerFgBrush}" HorizontalAlignment="Center"/>
                                        <TextBlock Text="{Binding LastReplacedNotesCount}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource WarningBannerFgBrush}" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="2" Background="{DynamicResource InfoBannerBgBrush}" BorderBrush="{DynamicResource InfoBannerBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="8,10" Margin="4,0">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="Пропущено" FontSize="11" Foreground="{DynamicResource InfoBannerFgBrush}" HorizontalAlignment="Center"/>
                                        <TextBlock Text="{Binding LastSkippedNotesCount}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource InfoBannerFgBrush}" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="3" Background="{DynamicResource ErrorBannerBgBrush}" BorderBrush="{DynamicResource ErrorBannerBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="8,10" Margin="4,0,0,0">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="Новых тегов" FontSize="11" Foreground="{DynamicResource ErrorBannerFgBrush}" HorizontalAlignment="Center"/>
                                        <TextBlock Text="{Binding LastCreatedTagsCount}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="6" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="6" Padding="6">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ShowImportPreviewChrome}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid>
                            <!-- Empty / Not selected placeholder -->
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasPreview}" Value="False">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock Text="Выберите файлы или папку для предварительного анализа"
                                           FontSize="13" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center"/>
                                <TextBlock Text="До применения изменений вы сможете проверить пути, теги, потери конвертации и дубликаты."
                                           FontSize="11" Foreground="{DynamicResource LineMutedBrush}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                            </StackPanel>

                            <!-- Items List -->
                            <StackPanel Orientation="Vertical">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasPreview}" Value="False">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                    <!-- Diagnostics if any -->
                                    <Border x:Name="ImportDiagnosticsBanner" x:FieldModifier="public"
                                            Background="{DynamicResource ErrorBannerBgBrush}" BorderBrush="{DynamicResource ErrorBannerBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="8,6" Margin="0,0,0,8"
                                            AutomationProperties.Name="Баннер диагностики импорта"
                                            AutomationProperties.AutomationId="ImportDiagnosticsBanner">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasDiagnostics}" Value="False">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel>
                                            <TextBlock Text="Пропущенные файлы и ошибки разбора:" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource ErrorBannerFgBrush}" Margin="0,0,0,6"/>
                                            <ItemsControl ItemsSource="{Binding Diagnostics}"
                                                          AutomationProperties.Name="Диагностика импорта"
                                                          AutomationProperties.AutomationId="ImportDiagnosticsList">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock FontSize="11" Foreground="{DynamicResource ErrorBannerFgBrush}" Margin="0,2" TextWrapping="Wrap">
                                                            <Run Text="• " FontWeight="Bold"/>
                                                            <Run Text="{Binding FileName, Mode=OneWay}" FontWeight="SemiBold"/>
                                                            <Run Text=": "/>
                                                            <Run Text="{Binding Reason, Mode=OneWay}"/>
                                                        </TextBlock>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>

                                    <!-- Notes Preview List -->
                                    <ItemsControl ItemsSource="{Binding PreviewItems}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,5">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>

                                                        <!-- Left info -->
                                                        <StackPanel Grid.Column="0" Orientation="Vertical">
                                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                                                <TextBlock Text="{Binding DisplayTitle}" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource InkBrush}" TextTrimming="CharacterEllipsis"/>
                                                                <TextBlock Text="{Binding SourceFileName, StringFormat=' ({0})'}" FontSize="11" Foreground="{DynamicResource MutedBrush}"/>
                                                            </StackPanel>
                                                            <TextBlock Text="{Binding SourcePath}" FontSize="10" Foreground="{DynamicResource LineMutedBrush}" TextTrimming="CharacterEllipsis"
                                                                       ToolTip="{Binding SourcePath}"/>
                                                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                                <TextBlock Text="Теги: " FontSize="11" Foreground="{DynamicResource MutedBrush}"/>
                                                                <TextBlock Text="{Binding TagsDisplay}" FontSize="11" Foreground="{DynamicResource AccentBrush}" FontWeight="Medium"/>
                                                            </StackPanel>
                                                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                                <TextBlock Text="Сопоставление: " FontSize="11" Foreground="{DynamicResource MutedBrush}"/>
                                                                <TextBlock Text="{Binding MappingDisplay}" FontSize="11" Foreground="{DynamicResource InkBrush}"/>
                                                            </StackPanel>
                                                            <TextBlock Text="{Binding LostElementsDisplay}" FontSize="11" Foreground="{DynamicResource WarningBannerFgBrush}" TextWrapping="Wrap" Margin="0,2,0,0"/>

                                                            <TextBlock Text="{Binding ConflictReason}" FontSize="11" Foreground="{DynamicResource WarningBannerFgBrush}" FontWeight="Medium" Margin="0,2,0,0" TextWrapping="Wrap">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsConflict}" Value="True">
                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </StackPanel>

                                                        <!-- Status badge -->
                                                        <Border Grid.Column="1" CornerRadius="6" Padding="8,4" VerticalAlignment="Center" Margin="8,0,0,0">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Background" Value="{DynamicResource SuccessBannerBgBrush}"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsConflict}" Value="True">
                                                                            <Setter Property="Background" Value="{DynamicResource WarningBannerBgBrush}"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <TextBlock Text="{Binding Status}" FontSize="11" FontWeight="SemiBold">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Foreground" Value="{DynamicResource SuccessBannerFgBrush}"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsConflict}" Value="True">
                                                                                <Setter Property="Foreground" Value="{DynamicResource WarningBannerFgBrush}"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </Border>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <TextBlock Grid.Row="7" Text="{Binding ImportStatusMessage}" TextWrapping="Wrap"
                               FontSize="12" FontWeight="Medium" Foreground="{DynamicResource InfoBannerFgBrush}" Margin="0,8,0,0"
                               AutomationProperties.LiveSetting="Polite"/>
                </Grid>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="{x:Static h:UserTaskCopy.ArchiveTab}" FontSize="13" FontWeight="SemiBold" Padding="12,6"
                     ToolTip="Создание переносимого архива с паролем и обязательная проверка recovery key">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,14,0,0">
                    <StackPanel>
                        <Border Background="{DynamicResource InfoBannerBgBrush}" BorderBrush="{DynamicResource InfoBannerBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,0,12">
                            <TextBlock Text="{Binding LastSuccessfulEncryptedArchiveBanner, Mode=OneWay}" TextWrapping="Wrap"
                                       FontSize="12" Foreground="{DynamicResource InfoBannerFgBrush}"
                                       ToolTip="Фактический путь и время успешной проверки, не текущий выбор файла"/>
                        </Border>

                        <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,12"
                                   Text="Новый файл .qnar: вся база и вложения как на диске, отдельный пароль архива, shipping PBKDF2 по умолчанию. Recovery key оборачивает ключ архива и не заменяет пароль заметки. Настройка завершается только после контрольного dry-run с введённым ключом."/>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding EncryptedArchiveDestinationPath, UpdateSourceTrigger=PropertyChanged}"
                                     Height="30" VerticalContentAlignment="Center" Padding="8,0" Margin="0,0,8,0"
                                     IsEnabled="{Binding CanEditEncryptedArchiveCreateInputs}"
                                     ToolTip="Путь нового файла .qnar (существующий файл не заменяется)"/>
                            <Button Grid.Column="1" Content="Обзор…" Command="{Binding BrowseEncryptedArchivePathCommand}"
                                    Height="30" Padding="12,0"
                                    Background="{DynamicResource ButtonBgBrush}" Foreground="{DynamicResource ButtonFgBrush}"
                                    BorderThickness="0" Cursor="Hand"
                                    ToolTip="Выбрать новый путь .qnar"/>
                        </Grid>

                        <TextBlock Text="Пароль архива" FontSize="12" FontWeight="Medium" Foreground="{DynamicResource InkBrush}" Margin="0,4,0,4"/>
                        <PasswordBox x:Name="EncryptedArchivePasswordBox" Height="30" VerticalContentAlignment="Center" Padding="8,0" Margin="0,0,0,8"
                                     IsEnabled="{Binding CanEditEncryptedArchiveCreateInputs}"
                                     ToolTip="Отдельный пароль файла архива, не пароль заметки"/>
                        <TextBlock Text="Подтверждение пароля архива" FontSize="12" FontWeight="Medium" Foreground="{DynamicResource InkBrush}" Margin="0,0,0,4"/>
                        <PasswordBox x:Name="EncryptedArchivePasswordConfirmBox" Height="30" VerticalContentAlignment="Center" Padding="8,0" Margin="0,0,0,12"
                                     IsEnabled="{Binding CanEditEncryptedArchiveCreateInputs}"
                                     ToolTip="Повторите пароль архива"/>

                        <Button Content="Создать .qnar" Command="{Binding CreateEncryptedArchiveCommand}"
                                Height="34" Padding="16,0" HorizontalAlignment="Left" Margin="0,0,0,12"
                                Background="{DynamicResource AccentBrush}" Foreground="White" FontWeight="SemiBold"
                                BorderThickness="0" Cursor="Hand"
                                ToolTip="Создать архив с production default N и показать recovery key один раз"/>

                        <StackPanel>
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasPendingRecoveryVerification}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <Border Background="{DynamicResource WarningBannerBgBrush}" BorderBrush="{DynamicResource WarningBannerBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,0,8">
                                <StackPanel>
                                    <TextBlock Text="{Binding RecoveryKeyShowOnceWarningText, Mode=OneWay}" TextWrapping="Wrap"
                                               FontSize="12" Foreground="{DynamicResource WarningBannerFgBrush}" FontWeight="Medium"/>
                                    <TextBlock Text="{Binding RecoveryKeyDoesNotReplaceNotePasswordText, Mode=OneWay}" TextWrapping="Wrap"
                                               FontSize="12" Foreground="{DynamicResource WarningBannerFgBrush}" Margin="0,8,0,0"/>
                                    <TextBlock Text="{Binding EncryptedArchiveSetupIncompleteHint, Mode=OneWay}" TextWrapping="Wrap"
                                               FontSize="12" Foreground="{DynamicResource WarningBannerFgBrush}" Margin="0,8,0,0"/>
                                </StackPanel>
                            </Border>
                            <TextBlock Text="Recovery key (сохраните отдельно, показывается один раз)" FontSize="12" FontWeight="Medium"
                                       Foreground="{DynamicResource InkBrush}" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding ShownRecoveryKey, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"
                                     FontFamily="Consolas" FontSize="13" Padding="8" Margin="0,0,0,8"
                                     ToolTip="Ключ можно выделить вручную. Автоматического копирования в буфер нет."/>
                            <TextBlock Text="{Binding EncryptedArchiveOfflineCopyHint, Mode=OneWay}" TextWrapping="Wrap"
                                       FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,8"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <Button Content="Сохранить офлайн-копию…" Command="{Binding SaveRecoveryKeyOfflineCopyCommand}"
                                        Height="32" Padding="14,0" Margin="0,0,8,0"
                                        Background="{DynamicResource ButtonBgBrush}" Foreground="{DynamicResource ButtonFgBrush}"
                                        BorderThickness="0" Cursor="Hand"
                                        IsEnabled="{Binding CanEditEncryptedArchiveRecoveryInputs}"
                                        ToolTip="Новый текстовый файл с ключом и контрольной суммой. Не в каталог .qnar. Нужно подтверждение."/>
                                <Button Content="Печать…" Command="{Binding PrintRecoveryKeyCommand}"
                                        Height="32" Padding="14,0"
                                        Background="{DynamicResource ButtonBgBrush}" Foreground="{DynamicResource ButtonFgBrush}"
                                        BorderThickness="0" Cursor="Hand"
                                        IsEnabled="{Binding CanEditEncryptedArchiveRecoveryInputs}"
                                        ToolTip="Печатная копия того же payload. Нужно подтверждение. Без буфера обмена."/>
                            </StackPanel>
                            <TextBlock Text="Контрольное восстановление: введите recovery key" FontSize="12" FontWeight="Medium"
                                       Foreground="{DynamicResource InkBrush}" Margin="0,0,0,4"/>
                            <PasswordBox x:Name="EncryptedArchiveRecoveryConfirmBox" Height="30" VerticalContentAlignment="Center" Padding="8,0" Margin="0,0,0,10"
                                         IsEnabled="{Binding CanEditEncryptedArchiveRecoveryInputs}"
                                         ToolTip="Повторный ввод recovery key для dry-run созданного файла"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <Button Content="Проверить recovery key" Command="{Binding VerifyEncryptedArchiveRecoveryCommand}"
                                        Height="32" Padding="14,0" Margin="0,0,8,0"
                                        Background="{DynamicResource AccentBrush}" Foreground="White" FontWeight="SemiBold"
                                        BorderThickness="0" Cursor="Hand"
                                        ToolTip="Dry-run архива только через recovery wrap"/>
                                <Button Content="Отмена" Command="{Binding CancelEncryptedArchiveSetupCommand}"
                                        Height="32" Padding="14,0"
                                        Background="{DynamicResource ButtonBgBrush}" Foreground="{DynamicResource ButtonFgBrush}"
                                        BorderThickness="0" Cursor="Hand"
                                        ToolTip="Сбросить ключ в памяти. Last-success не меняется."/>
                            </StackPanel>
                        </StackPanel>

                        <TextBlock Text="Ротация recovery key" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{DynamicResource InkBrush}" Margin="0,16,0,6"/>
                        <TextBlock Text="{Binding EncryptedArchiveRotateSectionHint, Mode=OneWay}" TextWrapping="Wrap"
                                   FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,8"/>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding EncryptedArchiveRotatePath, UpdateSourceTrigger=PropertyChanged}"
                                     Height="30" VerticalContentAlignment="Center" Padding="8,0" Margin="0,0,8,0"
                                     IsEnabled="{Binding CanEditEncryptedArchiveRotateInputs}"
                                     ToolTip="Существующий .qnar, у которого меняется только recovery wrap"/>
                            <Button Grid.Column="1" Content="Обзор…" Command="{Binding BrowseEncryptedArchiveRotatePathCommand}"
                                    Height="30" Padding="12,0"
                                    Background="{DynamicResource ButtonBgBrush}" Foreground="{DynamicResource ButtonFgBrush}"
                                    BorderThickness="0" Cursor="Hand"
                                    ToolTip="Выбрать существующий .qnar"/>
                        </Grid>
                        <TextBlock Text="Пароль архива (если ротация не через текущий ключ)" FontSize="12" FontWeight="Medium"
                                   Foreground="{DynamicResource InkBrush}" Margin="0,0,0,4"/>
                        <PasswordBox x:Name="EncryptedArchiveRotatePasswordBox" Height="30" VerticalContentAlignment="Center" Padding="8,0" Margin="0,0,0,8"
                                     IsEnabled="{Binding CanEditEncryptedArchiveRotateInputs}"
                                     ToolTip="Ровно один секрет: этот пароль или текущий recovery key ниже"/>
                        <TextBlock Text="Текущий recovery key (если ротация не через пароль архива)" FontSize="12" FontWeight="Medium"
                                   Foreground="{DynamicResource InkBrush}" Margin="0,0,0,4"/>
                        <PasswordBox x:Name="EncryptedArchiveRotateRecoveryBox" Height="30" VerticalContentAlignment="Center" Padding="8,0" Margin="0,0,0,10"
                                     IsEnabled="{Binding CanEditEncryptedArchiveRotateInputs}"
                                     ToolTip="Ровно один секрет: этот ключ или пароль архива выше"/>
                        <Button Content="Выпустить новый recovery key" Command="{Binding RotateEncryptedArchiveRecoveryCommand}"
                                Height="34" Padding="16,0" HorizontalAlignment="Left" Margin="0,0,0,12"
                                Background="{DynamicResource ButtonBgBrush}" Foreground="{DynamicResource ButtonFgBrush}" FontWeight="SemiBold"
                                BorderThickness="0" Cursor="Hand"
                                ToolTip="Атомарно заменить только recovery wrap. Нужно подтверждение."/>

                        <TextBlock Text="{Binding EncryptedArchiveStatusMessage, Mode=OneWay}" TextWrapping="Wrap"
                                   FontSize="12" FontWeight="Medium" Foreground="{DynamicResource InfoBannerFgBrush}"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- BOTTOM ACTION BUTTONS -->
        <Border Grid.Row="1" Background="Transparent" Padding="0,14,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <CheckBox Grid.Row="0" Margin="0,0,0,10"
                          IsChecked="{Binding LossesAcknowledged}"
                          IsEnabled="{Binding CanAcknowledgeLosses}"
                          AutomationProperties.Name="Подтвердить потери конвертации"
                          AutomationProperties.AutomationId="ImportLossAckCheckBox"
                          ToolTip="Без этого подтверждения commit недоступен, если есть потери">
                    <CheckBox.Style>
                        <Style TargetType="CheckBox">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding SelectedTabIndex}" Value="1"/>
                                        <Condition Binding="{Binding HasCompletedImport}" Value="False"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible"/>
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </CheckBox.Style>
                    <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource InkBrush}"
                               Text="Я видел неподдерживаемые элементы и потери; продолжить импорт Markdown."/>
                </CheckBox>
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Content="Закрыть" Command="{Binding CloseCommand}"
                        IsEnabled="{Binding CanCloseImportExportWindow}" IsCancel="True"
                        Height="32" Width="90" HorizontalAlignment="Left"
                        Background="{DynamicResource ButtonBgBrush}" Foreground="{DynamicResource ButtonFgBrush}" BorderThickness="0" Cursor="Hand"
                        AutomationProperties.Name="Закрыть окно импорта и экспорта"
                        ToolTip="Закрыть окно импорта и экспорта (Esc)"/>

                <!-- Confirm Import Button (only on import tab) -->
                <Button Grid.Column="1" Command="{Binding ConfirmImportCommand}"
                        Height="34" Padding="16,0"
                        FontWeight="SemiBold" BorderThickness="0" Cursor="Hand"
                        AutomationProperties.Name="Применить импорт"
                        AutomationProperties.AutomationId="ConfirmImportButton"
                        ToolTip="Применить импорт заметок в базу данных">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Setter Property="IsEnabled" Value="{Binding CanConfirmImport, Mode=OneWay}"/>
                            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="Opacity" Value="1"/>
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding SelectedTabIndex}" Value="1"/>
                                        <Condition Binding="{Binding HasCompletedImport}" Value="False"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible"/>
                                </MultiDataTrigger>
                                <DataTrigger Binding="{Binding CanConfirmImport}" Value="False">
                                    <Setter Property="Background" Value="{DynamicResource ButtonBgBrush}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
                                    <Setter Property="Opacity" Value="0.55"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <TextBlock>
                        <Run Text="Применить импорт"/>
                        <Run Text="{Binding TotalNotesToImport, Mode=OneWay, StringFormat=' ({0})'}"/>
                    </TextBlock>
                </Button>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
