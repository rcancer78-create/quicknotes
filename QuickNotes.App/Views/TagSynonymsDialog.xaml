<Window x:Class="QuickNotes.App.Views.TagSynonymsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title}"
        Height="360" Width="440"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource CanvasBrush}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Управление синонимами для автоматического определения тега"
                   FontSize="12" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,12"/>

        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox Text="{Binding NewSynonymValue, UpdateSourceTrigger=PropertyChanged}"
                     Height="32" VerticalContentAlignment="Center" Padding="8,0"
                     FontSize="13" BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1"
                     ToolTip="Введите новый синоним"
                     x:Name="NewSynonymBox"/>
            <Button Grid.Column="1" Content="Добавить" Command="{Binding AddSynonymCommand}" IsDefault="True"
                    Width="90" Height="32" Margin="8,0,0,0"
                    ToolTip="Добавить синоним к текущему тегу"
                    Background="{DynamicResource AccentBrush}" Foreground="White" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand"/>
        </Grid>

        <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="4">
            <ListBox ItemsSource="{Binding Synonyms}" BorderThickness="0" Background="Transparent">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="4,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Value}" VerticalAlignment="Center" FontSize="13" Foreground="{DynamicResource InkBrush}"/>
                            <Button Grid.Column="1" Content="×"
                                    Command="{Binding DataContext.DeleteSynonymCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                    CommandParameter="{Binding}"
                                    Width="24" Height="24" FontSize="14" FontWeight="Bold"
                                    Background="Transparent" Foreground="{DynamicResource ErrorBannerFgBrush}" BorderThickness="0" Cursor="Hand"
                                    ToolTip="Удалить синоним"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <Button Grid.Row="3" Content="Закрыть" Command="{Binding CloseCommand}"
                Width="90" Height="32" Margin="0,12,0,0" HorizontalAlignment="Right"
                ToolTip="Закрыть диалог"
                Background="{DynamicResource ButtonBgBrush}" Foreground="{DynamicResource ButtonFgBrush}" BorderThickness="0" Cursor="Hand"/>
    </Grid>
</Window>
