<Window x:Class="QuickNotes.App.Views.ProtectionPasswordDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Пароль заметки"
        Width="420" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource CanvasBrush}">
    <StackPanel Margin="22">
        <TextBlock x:Name="MessageText" TextWrapping="Wrap" FontSize="13"
                   Foreground="{DynamicResource InkBrush}" Margin="0,0,0,14"/>

        <TextBlock Text="Пароль:" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,4"/>
        <PasswordBox x:Name="PasswordInput" Height="30" FontSize="13"
                     KeyDown="PasswordInput_KeyDown" Margin="0,0,0,10"
                     Foreground="{DynamicResource InkBrush}"/>

        <TextBlock x:Name="ConfirmLabel" Text="Подтверждение пароля:" FontSize="12"
                   Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,4"/>
        <PasswordBox x:Name="ConfirmInput" Height="30" FontSize="13"
                     KeyDown="PasswordInput_KeyDown" Margin="0,0,0,14"
                     Foreground="{DynamicResource InkBrush}"/>

        <TextBlock x:Name="WarningText" TextWrapping="Wrap" FontSize="11"
                   Foreground="{DynamicResource ErrorBannerFgBrush}" Margin="0,0,0,12"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Отмена" Width="96" Height="32" Margin="0,0,10,0" IsCancel="True"
                    Background="{DynamicResource ButtonBgBrush}" Foreground="{DynamicResource ButtonFgBrush}"/>
            <Button x:Name="OkButton" Content="OK" Width="96" Height="32" IsDefault="True"
                    Click="OkButton_Click"
                    Background="{DynamicResource AccentBrush}" Foreground="White" FontWeight="SemiBold"/>
        </StackPanel>
    </StackPanel>
</Window>