<Window x:Class="QuickNotes.App.Views.TagEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title}"
        Height="180" Width="380"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource CanvasBrush}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Название тега:" FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}" Margin="0,0,0,6"/>

        <TextBox Grid.Row="1" Text="{Binding TagName, UpdateSourceTrigger=PropertyChanged}"
                 Height="32" VerticalContentAlignment="Center" Padding="8,0"
                 FontSize="14" BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1"
                 ToolTip="Название тега"
                 x:Name="TagNameBox"/>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Отмена" Command="{Binding CancelCommand}"
                    Width="90" Height="32" Margin="0,0,8,0"
                    ToolTip="Отменить редактирование"
                    Background="{DynamicResource ButtonBgBrush}" Foreground="{DynamicResource ButtonFgBrush}" BorderThickness="0" Cursor="Hand"/>
            <Button Content="Сохранить" Command="{Binding SaveCommand}" IsDefault="True"
                    Width="100" Height="32"
                    ToolTip="Сохранить название тега"
                    Background="{DynamicResource AccentBrush}" Foreground="White" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand"/>
        </StackPanel>
    </Grid>
</Window>
