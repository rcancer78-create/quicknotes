<Window x:Class="QuickNotes.App.Views.DraftRecoveryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Восстановление черновика"
        Height="550" Width="750"
        MinHeight="400" MinWidth="550"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource CanvasBrush}">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header / Info -->
            <RowDefinition Height="Auto"/> <!-- Diff summary -->
            <RowDefinition Height="*"/>    <!-- Comparison columns -->
            <RowDefinition Height="Auto"/> <!-- Defer explanation -->
            <RowDefinition Height="Auto"/> <!-- Action buttons -->
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="⚠️ Обнаружен несохранённый черновик" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}"/>
                <TextBlock x:Name="SourceAndDateText" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0,3,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- Diff summary -->
        <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="8" Padding="10,6" Margin="0,0,0,10">
            <TextBlock x:Name="DiffSummaryText" FontSize="12" Foreground="{DynamicResource InkBrush}" TextWrapping="Wrap" FontFamily="Consolas, Segoe UI, Arial"/>
        </Border>

        <!-- Comparison side by side -->
        <Grid Grid.Row="2" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Committed content -->
            <Border Grid.Column="0" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="8" Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" x:Name="CommittedHeaderBlock" Text="Сохранённая версия" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,6"/>
                    <TextBox Grid.Row="1" x:Name="CommittedTitleBox" IsReadOnly="True" FontWeight="SemiBold" FontSize="13" Background="Transparent" Foreground="{DynamicResource InkBrush}" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource LineBrush}" Padding="0,2" Margin="0,0,0,6"/>
                    <TextBox Grid.Row="2" x:Name="CommittedTextBox" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Background="Transparent" Foreground="{DynamicResource InkBrush}" BorderThickness="0" FontFamily="Segoe UI, Arial" FontSize="12"/>
                </Grid>
            </Border>

            <!-- Draft content -->
            <Border Grid.Column="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" CornerRadius="8" Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Черновик (после сбоя)" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,6"/>
                    <TextBox Grid.Row="1" x:Name="DraftTitleBox" IsReadOnly="True" FontWeight="SemiBold" FontSize="13" Background="Transparent" Foreground="{DynamicResource InkBrush}" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource LineBrush}" Padding="0,2" Margin="0,0,0,6"/>
                    <TextBox Grid.Row="2" x:Name="DraftTextBox" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Background="Transparent" Foreground="{DynamicResource InkBrush}" BorderThickness="0" FontFamily="Segoe UI, Arial" FontSize="12"/>
                </Grid>
            </Border>
        </Grid>

        <TextBlock x:Name="KeepCommittedExplanationText" Grid.Row="3"
                   FontSize="11" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"
                   HorizontalAlignment="Stretch" TextAlignment="Left" Margin="0,0,0,8"
                   AutomationProperties.Name="Пояснение действия «Отложить»"/>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button x:Name="DiscardDraftButton" Grid.Column="0" Content="🗑️ Удалить черновик" Click="OnDiscardClick"
                    HorizontalAlignment="Left" VerticalAlignment="Center" Height="30" Padding="14,0"
                    Background="{DynamicResource ButtonBgBrush}" Foreground="{DynamicResource ButtonFgBrush}"
                    FontWeight="Medium"
                    AutomationProperties.Name="Удалить черновик"
                    ToolTip="Удалить несохранённый черновик и оставить текущую версию"/>

            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button x:Name="KeepCommittedButton" Content="Отложить" Click="OnKeepCommittedClick"
                        Height="30" Padding="14,0" Margin="0,0,10,0"
                        Background="{DynamicResource ButtonBgBrush}" Foreground="{DynamicResource ButtonFgBrush}"
                        FontWeight="Medium"
                        AutomationProperties.Name="Отложить восстановление черновика"
                        ToolTip="Закрыть окно и не изменять текущую сохранённую версию"/>

                <Button x:Name="RestoreDraftButton" Content="✓ Восстановить черновик" Click="OnRestoreClick" IsDefault="True"
                        Height="30" Padding="16,0"
                        Background="{DynamicResource AccentBrush}" Foreground="White"
                        FontWeight="SemiBold"
                        AutomationProperties.Name="Восстановить черновик"
                        ToolTip="Загрузить содержимое и свойства черновика в редактор для проверки и сохранения"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
