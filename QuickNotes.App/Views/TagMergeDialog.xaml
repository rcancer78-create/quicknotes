<Window x:Class="QuickNotes.App.Views.TagMergeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title}"
        Height="540" Width="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource CanvasBrush}">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 1. SOURCE TAG -->
        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="Исходный тег:" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,4"/>
            <Border Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="6" Padding="10,6">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="🏷️ " FontSize="12" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding SourceTagFullPath}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- 2. TARGET TAG SELECTION -->
        <StackPanel Grid.Row="1" Margin="0,0,0,10">
            <TextBlock Text="Целевой тег (в него будут перенесены связи):" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,4"/>
            <ComboBox ItemsSource="{Binding AvailableTargets}" SelectedItem="{Binding SelectedTargetTag}"
                      DisplayMemberPath="Name"
                      ToolTip="Выберите целевой тег для слияния"
                      Height="34" VerticalContentAlignment="Center" FontSize="13"/>
            <TextBlock Text="Исходный тег и его потомки исключены из списка во избежание циклов."
                       FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,3,0,0"/>
        </StackPanel>

        <!-- 3. WARNING BANNER -->
        <Border Grid.Row="2" Background="{DynamicResource ErrorBannerBgBrush}" BorderBrush="{DynamicResource ErrorBannerBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="⚠️" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Top"/>
                <TextBlock Grid.Column="1" Text="{Binding WarningMessage}" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource ErrorBannerFgBrush}" FontWeight="Medium"/>
            </Grid>
        </Border>

        <!-- 4. PREVIEW DETAILS -->
        <Border Grid.Row="3" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,8">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Предварительный просмотр последствий:" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}" Margin="0,0,0,8"/>

                    <Grid Margin="0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Затрагиваемых активных заметок:" Foreground="{DynamicResource InkBrush}" FontSize="12"/>
                        <TextBlock Grid.Column="1" Text="{Binding AffectedNotesText}" FontWeight="Bold" Foreground="{DynamicResource InkBrush}" FontSize="12"/>
                    </Grid>

                    <Grid Margin="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Уже существующих дубликатов связей (NoteTag):" Foreground="{DynamicResource InkBrush}" FontSize="12"/>
                            <TextBlock Text="сохраняется активный и ручной статус при конфликте" FontSize="10" Foreground="{DynamicResource MutedBrush}"/>
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="{Binding DuplicatesText}" FontWeight="Bold" Foreground="{DynamicResource InkBrush}" FontSize="12" VerticalAlignment="Center"/>
                    </Grid>

                    <Grid Margin="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Синонимов исходного тега:" Foreground="{DynamicResource InkBrush}" FontSize="12"/>
                            <TextBlock Text="переносятся без регистронезависимых дубликатов" FontSize="10" Foreground="{DynamicResource MutedBrush}"/>
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="{Binding SynonymsText}" FontWeight="Bold" Foreground="{DynamicResource InkBrush}" FontSize="12" VerticalAlignment="Center"/>
                    </Grid>

                    <Grid Margin="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Дочерних тегов исходного тега:" Foreground="{DynamicResource InkBrush}" FontSize="12"/>
                            <TextBlock Text="будут безопасно перемещены под целевой тег" FontSize="10" Foreground="{DynamicResource MutedBrush}"/>
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="{Binding ChildTagsText}" FontWeight="Bold" Foreground="{DynamicResource InkBrush}" FontSize="12" VerticalAlignment="Center"/>
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- 5. STATUS / EXPLANATION -->
        <TextBlock Grid.Row="4" Text="{Binding StatusExplanation}" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,10"/>

        <!-- 6. BUTTONS -->
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Отмена" Command="{Binding CancelCommand}" IsCancel="True"
                    Width="90" Height="32" Margin="0,0,8,0"
                    ToolTip="Отменить объединение тегов"
                    Background="{DynamicResource ButtonBgBrush}" Foreground="{DynamicResource ButtonFgBrush}" BorderThickness="0" Cursor="Hand"/>
            <Button Content="Объединить" Command="{Binding ConfirmCommand}" IsEnabled="{Binding CanConfirm}" IsDefault="True"
                    Width="120" Height="32"
                    ToolTip="Выполнить объединение тегов"
                    Background="#DC2626" Foreground="White" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand"/>
        </StackPanel>
    </Grid>
</Window>
