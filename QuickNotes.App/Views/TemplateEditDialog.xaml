<Window x:Class="QuickNotes.App.Views.TemplateEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding DialogTitle}"
        Width="580" Height="540"
        MinWidth="480" MinHeight="440"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource CanvasBrush}"
        FocusManager.FocusedElement="{Binding ElementName=TitleTextBox}">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0" Text="{Binding DialogTitle}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource InkBrush}" Margin="0,0,0,12"/>

        <!-- Title -->
        <StackPanel Grid.Row="1" Margin="0,0,0,10">
            <TextBlock Text="Название шаблона:" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource InkBrush}" Margin="0,0,0,4"/>
            <TextBox x:Name="TitleTextBox" Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"
                     Height="30" VerticalContentAlignment="Center" Padding="8,0" FontSize="13"
                     BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1"
                     ToolTip="Введите название шаблона (до 100 символов)"/>
        </StackPanel>

        <!-- Text & Variable hint -->
        <Grid Grid.Row="2" Margin="0,0,0,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="Текст шаблона:" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource InkBrush}" Margin="0,0,0,4"/>
            <TextBox Grid.Row="1" Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"
                     AcceptsReturn="True" AcceptsTab="True" TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                     Padding="8" FontSize="13" FontFamily="Segoe UI"
                     BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1"
                     ToolTip="Текст шаблона. Поддерживает переменные подстановки."/>
            <Border Grid.Row="2" Background="{DynamicResource InfoBannerBgBrush}" BorderBrush="{DynamicResource InfoBannerBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,6,0,0">
                <TextBlock Text="Переменные: {{date}} — дата, {{time}} — время, {{datetime}} — дата и время, {{source}} — источник. Регистр не важен, пробелы внутри скобок допускаются."
                           FontSize="11" Foreground="{DynamicResource InfoBannerFgBrush}" TextWrapping="Wrap"/>
            </Border>
        </Grid>

        <!-- Tags Selection -->
        <StackPanel Grid.Row="3" Margin="0,0,0,10">
            <TextBlock Text="Теги шаблона:" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource InkBrush}" Margin="0,0,0,4"/>
            <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="6" Padding="8" MaxHeight="100">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding AvailableTags}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsSelected}" Content="{Binding TagName}"
                                          Margin="0,0,12,6" FontWeight="Medium"
                                          ToolTip="Включить тег в шаблон"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>
        </StackPanel>

        <!-- Error Banner -->
        <Border Grid.Row="4" Background="{DynamicResource ErrorBannerBgBrush}" BorderBrush="{DynamicResource ErrorBannerBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,0,0,10">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasError}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource ErrorBannerFgBrush}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap"/>
        </Border>

        <!-- Buttons -->
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Сохранить" Command="{Binding SaveCommand}"
                    IsDefault="True" Height="32" Padding="16,0" Margin="0,0,10,0"
                    Background="{DynamicResource AccentBrush}" Foreground="White" FontWeight="SemiBold"
                    ToolTip="Сохранить шаблон"/>
            <Button Content="Отмена" Command="{Binding CancelCommand}"
                    IsCancel="True" Height="32" Padding="16,0"
                    Background="{DynamicResource ButtonBgBrush}" Foreground="{DynamicResource ButtonFgBrush}" FontWeight="Medium"
                    ToolTip="Отменить изменения"/>
        </StackPanel>
    </Grid>
</Window>
