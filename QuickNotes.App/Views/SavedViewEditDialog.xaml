<Window x:Class="QuickNotes.App.Views.SavedViewEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title}"
        Height="190" Width="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource CanvasBrush}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Название вида:" FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}" Margin="0,0,0,6"/>

        <TextBox Grid.Row="1" Text="{Binding ViewName, UpdateSourceTrigger=PropertyChanged}"
                 Height="32" VerticalContentAlignment="Center" Padding="8,0"
                 FontSize="14" BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1"
                 ToolTip="Название сохранённого вида"
                 x:Name="ViewNameBox"/>

        <TextBlock Grid.Row="2" Text="Вид — это сохранённый фильтр, а не копия заметок. Удаление вида не удаляет заметки."
                   TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,8,0,0"/>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Отмена" Command="{Binding CancelCommand}"
                    Width="90" Height="32" Margin="0,0,8,0"
                    ToolTip="Отменить редактирование вида"
                    Background="{DynamicResource ButtonBgBrush}" Foreground="{DynamicResource ButtonFgBrush}" BorderThickness="0" Cursor="Hand"/>
            <Button Content="Сохранить" Command="{Binding SaveCommand}" IsDefault="True"
                    Width="100" Height="32"
                    ToolTip="Сохранить название вида"
                    Background="{DynamicResource AccentBrush}" Foreground="White" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand"/>
        </StackPanel>
    </Grid>
</Window>
