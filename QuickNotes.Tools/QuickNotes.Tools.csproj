<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>
    <AssemblyName>QuickNotes.Tools</AssemblyName>
    <RootNamespace>QuickNotes.Tools</RootNamespace>
    <Description>Console entry for local PBKDF2 cost measurement (archive default; kdf = note/sync/archive), isolated Argon2id spike, cold-start R2R, PresentMon scroll-FPS CSV parse, and DPAPI credential encryption for CI. Not a hidden WPF CLI.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Konscious.Security.Cryptography.Argon2" Version="1.3.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\QuickNotes.App\QuickNotes.App.csproj" />
  </ItemGroup>

</Project>
